class ReviewApp(App[None], inherit_bindings=False):
    """Interactive review of a diff, one hunk at a time."""

    TITLE = "neorev"
    CSS = REVIEW_CSS
    ENABLE_COMMAND_PALETTE = False
    # CSS class Textual puts on a screen covered by another.
    SUSPENDED_SCREEN_CLASS = "covered"
    BINDINGS: ClassVar[list[BindingType]] = [
        Binding("ctrl+c", "quit", show=False, priority=True, system=True),
    ]

    def __init__(self, state: ReviewState, session: Session) -> None:
        """Set up the review of *state* on a driver reading the controlling terminal."""
        super().__init__(driver_class=TtyDriver)
        self.state = state
        self.session = session
        self.delta_cache: dict[int, list[bytes]] = {}
        self.delta_complete: set[int] = set()
        self.delta_generation = 0
        self.delta_mismatch: str | None = None
        self.margin_markers: list[str] = []
        self.shown_index: int | None = None
        self.painted = 0
        self.line_rows: list[int] = []
        self.line_texts: list[Text] = []
        self.review_written = False
        self.reload_timer: Timer | None = None
        self.watch_process: subprocess.Popen[bytes] | None = None
        self.watch_stopped = False

    def get_default_screen(self) -> ReviewScreen:
        """Return the screen showing the review."""
        return ReviewScreen(self.state, self.refresh_diff)

    def on_mount(self) -> None:
        """Draw in the colours of the terminal rather than in a palette of our own."""
        self.theme = APP_THEME

    def on_ready(self) -> None:
        """Show the first hunk, and start watching the repository."""
        self.show_hunk()
        if self.session.watch is not None:
            self.start_watching()

    def on_unmount(self) -> None:
        """Stop the repository watcher."""
        self.stop_watching()

    @property
    def diff_log(self) -> Diff:
        """Return the widget showing the current hunk."""
        return self.query_one(Diff)

    def show_hunk(self) -> None:
        """Refresh the chrome and the diff view for the current hunk."""
        empty = self.state.is_empty
        for chrome in self.query(Chrome):
            chrome.display = not empty
            chrome.refresh()
        for row in self.query(MarkerRow):
            row.display = not empty
        self.diff_log.display = not empty
        self.query_one(f"#{EMPTY_ID}", Static).display = empty
        for count in self.query(HiddenRows):
            count.follow_view()
        if empty:
            self.shown_index = None
            return
        index = self.state.current_index
        if index != self.shown_index:
            self.diff_log.scroll_to(y=0, animate=False)
            self.shown_index = index
        streaming = index not in self.delta_complete
        if streaming:
            self.delta_cache.pop(index, None)
        self.refresh_diff()
        if streaming:
            self.stream_hunk(index, self.state.current_hunk.raw, self.delta_generation)

    def visible_end(self) -> int:
        """Return the display index just past the last line the diff view shows."""
        log = self.diff_log
        return log.scroll_offset.y + log.scrollable_content_region.height

    def refresh_diff(self) -> None:
        """Redraw the diff view from the delta output cached for the current hunk."""
        visible_end = self.visible_end()
        self.diff_log.clear()
        self.painted = 0
        self.line_rows = []
        self.line_texts = []
        if not self.state.is_empty:
            index = self.state.current_index
            self.margin_markers = build_margin_markers(self.state.current_hunk)
            self.write_cached_lines(index, visible_end)
            self.paint_diff(index)

    @work(exclusive=True, group=PAINT_WORKER_GROUP)
    async def paint_diff(self, index: int) -> None:
        """Write the delta output of hunk *index* below the view, batch by batch."""
        batch = max(1, self.diff_log.scrollable_content_region.height)
        while index == self.state.current_index and self.painted < len(
            self.delta_cache.get(index, [])
        ):
            await asyncio.sleep(0)
            if not self.is_running:
                return
            self.write_cached_lines(index, self.painted + batch)

    def write_cached_lines(self, index: int, upto: int) -> None:
        """Write the cached lines of hunk *index* from the paint cursor to *upto*."""
        lines = self.delta_cache.get(index, [])[self.painted : upto]
        self.write_diff_lines(self.painted, lines)
        self.painted += len(lines)

    def write_diff_lines(self, first: int, lines: list[bytes]) -> None:
        """Append delta output *lines*, the first of them at display index *first*."""
        log = self.diff_log
        width = log.scrollable_content_region.width
        if width <= 0:
            return
        for text in render_hunk_lines(lines, self.margin_markers[first:]):
            self.line_rows.append(len(log.lines))
            self.line_texts.append(text)
            log.write(text, width=width)

    def top_display_line(self) -> int:
        """Return the display line the diff view starts on."""
        return max(bisect_right(self.line_rows, self.diff_log.scroll_offset.y) - 1, 0)

    @work(thread=True, exclusive=True, group=DELTA_WORKER_GROUP)
    def stream_hunk(self, index: int, raw: str, generation: int) -> None:
        """Run ``delta`` on the hunk at *index* and feed its lines to the view."""
        worker = get_current_worker()
        pending = b""
        with delta_output(raw) as stdout:
            while chunk := stdout.read(DELTA_READ_SIZE):
                *complete, pending = (pending + chunk).split(b"\n")
                if worker.is_cancelled:
                    return
                self.call_from_thread(
                    self.absorb_delta_lines, index, generation, complete
                )
        if worker.is_cancelled:
            return
        if pending:
            self.call_from_thread(self.absorb_delta_lines, index, generation, [pending])
        self.call_from_thread(self.mark_delta_complete, index, generation)

    def absorb_delta_lines(
        self,
        index: int,
        generation: int,
        lines: list[bytes],
    ) -> None:
        """Cache streamed delta *lines* of hunk *index* and show the new ones."""
        if generation != self.delta_generation:
            return
        cache = self.delta_cache.setdefault(index, [])
        if not cache and lines and not lines[0]:
            lines = lines[1:]
        cache.extend(lines)
        if lines and index == self.state.current_index:
            self.write_cached_lines(index, self.visible_end())
            self.paint_diff(index)

    def mark_delta_complete(self, index: int, generation: int) -> None:
        """Record the delta output of hunk *index* as fully cached."""
        if generation != self.delta_generation:
            return
        self.delta_complete.add(index)
        self.check_delta_shape(
            self.state.hunks[index], len(self.delta_cache.get(index, []))
        )

    def check_delta_shape(self, hunk: Hunk, rows: int) -> bool:
        """Leave the review when a hunk with display lines has a different row count."""
        expected = len(hunk.display_lines)
        # A rename carries no body, so delta renders its header instead of lines.
        if not expected or rows == expected:
            return True
        self.delta_mismatch = (
            f"{hunk.short_location}: {rows} rows for {expected} diff lines"
        )
        self.exit(return_code=os.EX_SOFTWARE)
        return False

    def edit_note_text(
        self,
        existing: str,
        location: str,
        context_lines: list[str] | None = None,
    ) -> str:
        """Suspend the review and edit *existing* in ``$EDITOR``."""
        with self.suspend():
            return edit_comment_in_editor(existing, location, context_lines)

    def action_move(self, delta: int) -> None:
        """Move the review by *delta* hunks."""
        if not self.state.is_empty and self.state.move(delta):
            self.show_hunk()

    def action_scroll_half_page(self, direction: int) -> None:
        """Scroll the diff half a page in *direction*."""
        log = self.diff_log
        half = max(1, log.scrollable_content_region.height // 2)
        log.scroll_relative(y=direction * half, animate=False)

    def action_approve(self) -> None:
        """Approve the current hunk."""
        if not self.state.is_empty:
            self.state.approve()
            self.show_hunk()

    def action_approve_file(self) -> None:
        """Approve every note-free hunk of the current file."""
        if not self.state.is_empty:
            self.state.approve_file()
            self.show_hunk()

    def action_question(self) -> None:
        """Ask a question about the current hunk or one of its lines."""
        self.start_hunk_note(NoteKind.QUESTION)

    def action_flag(self) -> None:
        """Request a change on the current hunk or one of its lines."""
        self.start_hunk_note(NoteKind.FLAG)

    def action_global_note(self) -> None:
        """Add a note tied to no particular hunk."""
        self.push_screen(GlobalNoteKind(), self.write_global_note)

    def action_manage_notes(self) -> None:
        """Open the list of every note taken so far."""
        self.push_screen(NotesScreen(self.state, self.edit_note_text, self.show_hunk))

    def action_toggle_help(self) -> None:
        """Show the key panel, or hide it when it is already up."""
        if self.screen.query(HelpPanel):
            self.action_hide_help_panel()
        else:
            self.action_show_help_panel()

    def start_hunk_note(self, kind: NoteKind) -> None:
        """Ask which line a note of *kind* targets, then write it."""
        if self.state.is_empty:
            return
        hunk = self.state.current_hunk
        if not hunk.selectable_lines:
            self.write_hunk_note(kind, HunkTarget())
            return
        line_texts = self.hunk_line_texts()
        if not self.check_delta_shape(hunk, len(line_texts)):
            return
        picker = LinePicker(self.state, kind, self.top_display_line(), line_texts)
        self.push_screen(picker, partial(self.write_hunk_note, kind))

    def hunk_line_texts(self) -> list[Text]:
        """Return the renderable of every delta line of the current hunk."""
        index = self.state.current_index
        cached = self.delta_cache.get(index, [])
        if index in self.delta_complete and len(self.line_texts) == len(cached):
            return self.line_texts
        raw = self.state.current_hunk.raw
        return render_hunk_lines(render_through_delta(raw), self.margin_markers)

    def write_hunk_note(self, kind: NoteKind, target: NoteTarget | None) -> None:
        """Edit the note of *kind* on *target*, dropping it when left empty."""
        if target is None:
            return
        hunk = self.state.current_hunk
        existing = hunk.get_note(target)
        text = self.edit_note_text(
            existing.text if existing is not None else "",
            f"{hunk.short_location}{HEADING_TARGET_SEPARATOR}{target}"
            f" [{kind.editor_label}]",
            hunk.build_editor_context(target, self.top_display_line()),
        )
        if text:
            hunk.upsert_note(kind, target, text)
            hunk.approved = False
            if isinstance(target, HunkTarget):
                self.state.advance_to_next_unhandled()
        elif existing is not None:
            hunk.remove_note(target)
        self.show_hunk()

    def write_global_note(self, kind: NoteKind | None) -> None:
        """Edit a global note of *kind* and add it to the review."""
        if kind is None:
            return
        text = self.edit_note_text("", kind.global_editor_label)
        if text:
            self.state.global_notes.append(GlobalNote(kind=kind, text=text))
        self.show_hunk()

    def start_watching(self) -> None:
        """Watch the repository for changes, from scratch."""
        self.watch_stopped = False
        self.watch_repo()

    @work(thread=True, exclusive=True, group=WATCH_WORKER_GROUP)
    def watch_repo(self) -> None:
        """Report every change of the watched repository as a pending reload."""
        root = jj_root()
        paths = watch_paths(root) if root is not None else []
        worker = get_current_worker()
        if not paths or worker.is_cancelled or self.watch_stopped:
            return
        with inotify_events(paths) as (process, events):
            self.watch_process = process
            if worker.is_cancelled or self.watch_stopped:
                return
            for _ in events:
                if worker.is_cancelled:
                    return
                self.call_from_thread(self.schedule_reload)

    def stop_watching(self) -> None:
        """Terminate the ``inotifywait`` process, if one is running."""
        self.watch_stopped = True
        if self.watch_process is not None and self.watch_process.poll() is None:
            self.watch_process.terminate()
            self.watch_process.wait()
        self.watch_process = None

    def schedule_reload(self) -> None:
        """Restart the timer coalescing repository events into one reload."""
        if self.reload_timer is not None:
            self.reload_timer.stop()
        self.reload_timer = self.set_timer(WATCH_DEBOUNCE_TIMEOUT, self.reload)

    def reload(self) -> None:
        """Rebuild the review from the watched source after a repository change."""
        source = self.session.watch
        if source is None:
            return
        if not isinstance(self.screen, ReviewScreen):
            self.schedule_reload()
            return
        self.save_review()
        diff_text, self.session.diff_source = fetch_watch_diff(source)
        if diff_text == self.session.diff_text and not self.state.is_empty:
            return
        self.session.diff_text = diff_text
        self.state.adopt(build_watch_state(diff_text, self.session.output_path))
        self.delta_cache.clear()
        self.delta_complete.clear()
        self.delta_generation += 1
        self.shown_index = None
        self.stop_watching()
        self.start_watching()
        self.show_hunk()

    def save_review(self) -> None:
        """Write the review to its output file when it holds any user action."""
        if not review_has_content(self.state.hunks, self.state.global_notes):
            return
        write_review_output(
            self.session.output_path,
            self.state.hunks,
            self.state.global_notes,
            self.session.diff_source,
            quiet=True,
        )
        self.review_written = True


def build_arg_parser() -> argparse.ArgumentParser:
    """Build and return the argument parser for neorev."""
    parser = argparse.ArgumentParser(
        prog="neorev",
        description=__doc__,
        epilog="When no diff is piped and no revision is given, defaults to "
        f"'jj show {JJ_DEFAULT_REV}' in the current jujutsu repository.",
    )
    parser.add_argument(
        "-c",
        "--clear",
        action="store_true",
        help="Discard previous review and start fresh",
    )
    parser.add_argument(
        "-j",
        "--jj",
        dest="source",
        nargs="?",
        type=JjSource,
        const=JjSource(None),
        default=None,
        metavar="REV",
        help="Run 'jj show [REV]' and use its output as the diff",
    )
    parser.add_argument(
        "-o",
        "--output",
        default=None,
        help="Output file for the review (created or updated); "
        "defaults to $XDG_STATE_HOME/agents/reviews/<project>/<rev>-neorev.md",
    )
    parser.add_argument(
        "-x",
        "--clip",
        action="store_true",
        help="Copy @output_file to clipboard (via xclip) on exit",
    )
    parser.add_argument(
        "-w",
        "--watch",
        action="store_true",
        help="Reload the review when the repository changes "
        "(requires inotifywait and a -j or auto-detected jj source)",
    )
    return parser


@dataclass
class JjMetadata:
    """Project metadata extracted from jujutsu for default output naming."""

    dirname: str
    rev: str | None = None


def project_name(path: Path) -> str:
    """Derive a project name from the last components of *path*."""
    parts = [p for p in path.parts if p != os.sep]
    tail = parts[-PROJECT_NAME_COMPONENTS:]
    return PROJECT_NAME_SEPARATOR.join(p.lower() for p in tail)


def run_jj(command: list[str]) -> str:
    """Run a jujutsu command and return stripped stdout."""
    result = subprocess.run(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=True,
    )
    return result.stdout.strip()


def jj_root() -> str | None:
    """Return the jujutsu repository root, or None when not inside a jj repo."""
    try:
        return run_jj(["jj", "root", "--ignore-working-copy"])
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None


def jj_workspace_roots() -> list[Path]:
    """Return the root directory of every workspace of the current jj repo."""
    output = run_jj(
        [
            "jj",
            "workspace",
            "list",
            "--ignore-working-copy",
            "-T",
            'root ++ "\\n"',
        ]
    )
    return [Path(line) for line in output.splitlines()]


def shared_workspace_root(cwd: Path, ws_roots: list[Path]) -> Path:
    """Return the directory shared by a repo's workspace roots, or *cwd*'s own root."""
    shared = Path(os.path.commonprefix([str(root) for root in ws_roots]).rstrip(os.sep))
    # a prefix cutting mid-component is not a real directory; back up to its parent
    if not shared.is_dir():
        shared = shared.parent
    current = max(
        (root for root in ws_roots if cwd.is_relative_to(root)),
        key=lambda root: len(root.parts),
        default=cwd,
    )
    if len(current.parts) - len(shared.parts) >= WORKSPACE_SHARE_MAX_DEPTH_DELTA:
        return current
    return shared


def jj_metadata(rev: str | None = None) -> JjMetadata:
    """Return project metadata from the current jj repo, or a name-only fallback."""
    cwd = Path.cwd()
    try:
        change_id = run_jj(
            [
                "jj",
                "log",
                "--no-graph",
                "--ignore-working-copy",
                "-r",
                rev if rev is not None else JJ_DEFAULT_REV,
                "-T",
                f'change_id.short({JJ_REV_LENGTH}) ++ "\\n"',
            ]
        )
        ws_roots = jj_workspace_roots()
    except (FileNotFoundError, subprocess.CalledProcessError):
        return JjMetadata(dirname=project_name(cwd))
    return JjMetadata(
        dirname=project_name(shared_workspace_root(cwd, ws_roots)),
        rev=change_id,
    )


def compact_path(path: str) -> str:
    """Replace the user's home directory prefix with ``~``."""
    home = str(Path.home())
    if path.startswith(home + os.sep) or path == home:
        return "~" + path[len(home) :]
    return path


def default_output_path(rev: str | None = None) -> str:
    """Build the default output path under the XDG state directory."""
    xdg_state = os.environ.get(
        "XDG_STATE_HOME",
        str(Path.home() / XDG_STATE_HOME_DEFAULT),
    )
    meta = jj_metadata(rev)
    state_dir = Path(xdg_state) / REVIEWS_STATE_DIR / meta.dirname

    parts = [DEFAULT_OUTPUT_STEM]
    if meta.rev is not None:
        parts.insert(0, meta.rev)
    filename = DEFAULT_OUTPUT_SEPARATOR.join(parts) + DEFAULT_OUTPUT_EXT
    return str(state_dir / filename)


def resolve_args(args: argparse.Namespace) -> None:
    """Fill in *args.output* with the default path when not provided."""
    if args.output is not None:
        return
    rev = args.source.rev if args.source is not None else None
    args.output = default_output_path(rev)


def fetch_diff_from_jj(command: list[str]) -> str:
    """Run a jujutsu command and return its stdout, exiting on failure."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=True)
    except FileNotFoundError:
        sys.stderr.write(f"Error: '{command[0]}' not found.\n")
        exit(os.EX_UNAVAILABLE)
    except subprocess.CalledProcessError as exc:
        sys.stderr.write(exc.stderr or f"Error: {command} failed.\n")
        exit(os.EX_DATAERR)

    if not result.stdout.strip():
        sys.stderr.write("Empty diff.\n")
        exit(os.EX_DATAERR)

    return result.stdout


def read_diff_from_stdin() -> str:
    """Read diff text from stdin, raising *NoDiffOnStdinError* when stdin is a TTY."""
    if sys.stdin.isatty():
        raise NoDiffOnStdinError

    diff_text = sys.stdin.read()
    if not diff_text.strip():
        sys.stderr.write("Empty diff.\n")
        exit(os.EX_DATAERR)

    return diff_text


def parse_diff_or_exit(diff_text: str) -> list[Hunk]:
    """Parse *diff_text* into hunks, exiting if it is malformed or holds none."""
    try:
        hunks = parse_diff(diff_text)
    except unidiff.UnidiffParseError as exc:
        sys.stderr.write(f"Malformed diff: {exc}\n")
        exit(os.EX_DATAERR)
    if not hunks:
        sys.stderr.write("No hunks found in diff.\n")
        exit(os.EX_DATAERR)
    return hunks


def load_or_resume_review(
    hunks: list[Hunk],
    output_path: str,
    *,
    quiet: bool = False,
) -> list[GlobalNote]:
    """
    Load a previous review from *output_path* if it exists.

    Applies matching annotations and approved-hunk hashes to *hunks*
    in place and returns the list of global notes. When *quiet* is set,
    suppresses the progress messages written to stderr.
    """
    previous_annotations, previous_global_notes, hashes_encoded = load_previous_review(
        output_path,
    )
    if (
        not previous_annotations
        and not previous_global_notes
        and hashes_encoded is None
    ):
        return []

    result = apply_previous_review(hunks, previous_annotations)

    approved_from_hashes = 0
    if hashes_encoded is not None:
        approved_set = decode_approved_hashes(hashes_encoded)
        for hunk in hunks:
            if hunk_identity_hash(hunk) in approved_set and not hunk.notes:
                hunk.approved = True
                approved_from_hashes += 1

    if quiet:
        return previous_global_notes

    display_path = compact_path(output_path)
    sys.stderr.write(
        f"Loaded {result.matched} hunk annotation(s), "
        f"{approved_from_hashes} approved hunk(s), and "
        f"{len(previous_global_notes)} global note(s) from {display_path}\n",
    )
    if result.stale_unmatched:
        sys.stderr.write(
            f"  ({result.stale_unmatched} previous annotation(s)"
            " no longer match any hunk)\n",
        )
    if result.stale_anchor:
        sys.stderr.write(
            f"  ({result.stale_anchor} previous annotation(s)"
            " were dropped because the hunk body changed)\n",
        )
    if result.stale_missing_target:
        sys.stderr.write(
            f"  ({result.stale_missing_target} previous annotation(s)"
            " target a line that no longer exists)\n",
        )
    return previous_global_notes


def review_has_content(hunks: list[Hunk], global_notes: list[GlobalNote]) -> bool:
    """Return True when the review contains any user action (approval or note)."""
    return (
        any(h.approved for h in hunks)
        or any(h.notes for h in hunks)
        or bool(global_notes)
    )


def review_is_all_clear(hunks: list[Hunk], global_notes: list[GlobalNote]) -> bool:
    """Return True when every hunk is approved and there are no global notes."""
    return all(h.approved for h in hunks) and not global_notes


def write_review_output(
    output_path: str,
    hunks: list[Hunk],
    global_notes: list[GlobalNote],
    diff_source: str | None = None,
    *,
    quiet: bool = False,
) -> None:
    """Write the final review output to *output_path*."""
    review_output = format_output(hunks, global_notes, diff_source)
    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(review_output)
    if not quiet:
        sys.stderr.write(f"Review written to {compact_path(output_path)}\n")


def copy_output_reference_to_clipboard(output_path: str) -> None:
    """Copy ``@output_path`` to the system clipboard via ``xclip``."""
    clip_text = f"@{compact_path(output_path)}"
    try:
        subprocess.run(
            ["xclip", "-selection", "clipboard"],
            input=clip_text.encode(),
            check=True,
            timeout=3,
        )
        sys.stderr.write(f"Copied '{clip_text}' to clipboard\n")
    except FileNotFoundError:
        sys.stderr.write("xclip not found — install it to use --clip\n")
    except (subprocess.TimeoutExpired, subprocess.CalledProcessError) as exc:
        sys.stderr.write(f"Clipboard copy failed: {exc}\n")


def jj_diff_command(rev: str | None) -> list[str]:
    """Return the command to show the jj diff for *rev*, or the working copy."""
    # No --ignore-working-copy here (unlike the metadata queries): snapshotting
    # imports pending edits into @ so the diff reflects the current files.
    cmd = ["jj", "show"]
    if rev is not None:
        cmd.append(rev)
    return cmd


def run_jj_diff(source: JjSource) -> tuple[str, str]:
    """Run the diff command for *source* and return ``(diff text, source label)``."""
    cmd = jj_diff_command(source.rev)
    return fetch_diff_from_jj(cmd), " ".join(cmd)


def ensure_jj_or_exit(parser: argparse.ArgumentParser) -> None:
    """Exit with a usage error when the working directory is not a jj repository."""
    if jj_root() is None:
        parser.print_usage(sys.stderr)
        sys.stderr.write(
            "\nError: no diff on stdin and not inside a jujutsu repository."
            " Pipe a diff or pass a revision with -j.\n",
        )
        exit(os.EX_USAGE)


def jj_op_heads_dir(root: str) -> Path:
    """Return the jj operation-heads directory, following a workspace repo pointer."""
    repo = Path(root) / ".jj" / "repo"
    # In a non-default workspace, .jj/repo is a file holding the path to the
    # default workspace's shared repo directory rather than the directory itself.
    if repo.is_file():
        repo = (repo.parent / repo.read_text().strip()).resolve()
    return repo / JJ_OP_HEADS_REL


def watch_paths(root: str) -> list[str]:
    """Return the jj operation-heads path to watch under *root*, if it exists."""
    op_heads = jj_op_heads_dir(root)
    return [str(op_heads)] if op_heads.exists() else []


def fetch_watch_diff(source: JjSource) -> tuple[str, str]:
    """Fetch the diff for *source*, returning ``("", label)`` on failure."""
    cmd = jj_diff_command(source.rev)
    label = " ".join(cmd)
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return "", label
    return result.stdout, label


def build_watch_state(diff_text: str, output_path: str) -> ReviewState:
    """Build review state for *diff_text*, hunk-less when it holds no diff."""
    hunks = parse_diff(diff_text) if diff_text.strip() else []
    global_notes = load_or_resume_review(hunks, output_path, quiet=True)
    return ReviewState(
        hunks=hunks,
        global_notes=global_notes,
        current_index=ReviewState.initial_index(hunks),
    )


def run_watch_session(args: argparse.Namespace, source: JjSource) -> None:
    """Run watch mode, handling the exit side effects."""
    if args.clear:
        Path(args.output).unlink(missing_ok=True)
    diff_text, diff_source = fetch_watch_diff(source)
    session = Session(
        output_path=args.output,
        diff_source=diff_source,
        diff_text=diff_text,
        watch=source,
    )
    app = ReviewApp(build_watch_state(diff_text, args.output), session)
    app.run(mouse=False)
    app.save_review()
    if app.review_written:
        sys.stderr.write(f"Review written to {compact_path(args.output)}\n")
        if args.clip:
            copy_output_reference_to_clipboard(args.output)
    exit_on_delta_mismatch(app)


def run_single_session(
    args: argparse.Namespace,
    diff_text: str,
    diff_source: str | None,
) -> None:
    """Run a one-shot review session and write its output on exit."""
    hunks = parse_diff_or_exit(diff_text)

    if args.clear:
        Path(args.output).unlink(missing_ok=True)

    global_notes = load_or_resume_review(hunks, args.output)
    state = ReviewState(
        hunks=hunks,
        global_notes=global_notes,
        current_index=ReviewState.initial_index(hunks),
    )
    session = Session(
        output_path=args.output,
        diff_source=diff_source,
        diff_text=diff_text,
    )
    app = ReviewApp(state, session)
    app.run(mouse=False)

    if review_has_content(hunks, global_notes):
        if review_is_all_clear(hunks, global_notes):
            sys.stderr.write(ALL_CLEAR_MESSAGE)
        else:
            write_review_output(args.output, hunks, global_notes, diff_source)
            if args.clip:
                copy_output_reference_to_clipboard(args.output)
    exit_on_delta_mismatch(app)


def exit_on_delta_mismatch(app: ReviewApp) -> None:
    """Report delta output that did not line up with the diff, and exit."""
    if app.delta_mismatch is None:
        return
    sys.stderr.write(f"{DELTA_MISMATCH_MESSAGE} ({app.delta_mismatch})\n")
    sys.exit(os.EX_SOFTWARE)


def resolve_diff_origin(
    args: argparse.Namespace,
    parser: argparse.ArgumentParser,
) -> JjSource | str:
    """
    Resolve where the diff comes from, from the -j flag or stdin.

    Returns a re-runnable jj source, or the piped stdin diff text.
    """
    source: JjSource | None = args.source
    if source is not None:
        return source
    try:
        return read_diff_from_stdin()
    except NoDiffOnStdinError:
        ensure_jj_or_exit(parser)
        return JjSource(None)


def main() -> None:
    """Run the neorev command-line entry point."""
    parser = build_arg_parser()
    args = parser.parse_args()
    resolve_args(args)

    if not os.environ.get("EDITOR"):
        sys.stderr.write("Error: $EDITOR is not set — required to write notes.\n")
        exit(os.EX_USAGE)

    if args.watch and shutil.which("inotifywait") is None:
        sys.stderr.write("Error: 'inotifywait' not found — required for --watch.\n")
        exit(os.EX_UNAVAILABLE)

    origin = resolve_diff_origin(args, parser)

    if args.watch:
        if isinstance(origin, str):
            parser.print_usage(sys.stderr)
            sys.stderr.write(
                "\nError: --watch needs a re-runnable jj source (-j or "
                "auto-detected); it cannot watch a piped diff.\n"
            )
            exit(os.EX_USAGE)
        run_watch_session(args, origin)
        return

    if isinstance(origin, str):
        diff_text, diff_source = origin, None
    else:
        diff_text, diff_source = run_jj_diff(origin)
    run_single_session(args, diff_text, diff_source)


if __name__ == "__main__":
    main()
