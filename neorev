@dataclass
class Hunk:
    """A single diff hunk with optional review annotation."""

    range_line: str
    body: str
    raw: str
    file_path: str
    file_status: FileStatus = FileStatus.MODIFIED
    old_path: str | None = None
    start_line: int | None = None
    approved: bool = False
    notes: list[HunkNote] = field(default_factory=list)
    display_lines: list[DisplayLine] = field(default_factory=list)

    @property
    def short_location(self) -> str:
        """Return a compact 'file:line' location string."""
        if self.start_line is None or self.file_status is FileStatus.DELETED:
            return self.file_path
        return f"{self.file_path}:{self.start_line}"

    @property
    def location_label(self) -> str:
        """Return the top-bar location, spelling out an 'old → new' rename."""
        if self.file_status is FileStatus.RENAMED and self.old_path is not None:
            return f"{self.old_path} {RENAME_ARROW} {self.short_location}"
        return self.short_location

    @property
    def selectable_lines(self) -> list[DisplayLine]:
        """Return the display lines a line-scoped note can target."""
        return [dl for dl in self.display_lines if dl.target is not None]

    @property
    def summary_status(self) -> Status | None:
        """Return a summary status for chrome/markers."""
        if self.approved:
            return Status.APPROVED
        if self.notes:
            if any(note.kind is NoteKind.FLAG for note in self.notes):
                return Status.FLAG
            if any(note.kind is NoteKind.QUESTION for note in self.notes):
                return Status.QUESTION
        return None

    @property
    def is_handled(self) -> bool:
        """Return whether the hunk has been reviewed."""
        return self.approved or bool(self.notes)

    def marker(self, *, is_current: bool) -> Text:
        """Return the styled marker of the hunk (3 visible chars)."""
        icon, style = MARKER_UNHANDLED, STYLE_DIM
        status = self.summary_status
        if status is Status.APPROVED:
            icon, style = MARKER_APPROVED, STYLE_APPROVED
        elif status is Status.FLAG:
            icon, style = MARKER_FLAG, STYLE_FLAG
        elif status is Status.QUESTION:
            icon, style = MARKER_QUESTION, STYLE_QUESTION
        if not is_current:
            return Text(" ").append(icon, style=style).append(" ")
        return (
            Text()
            .append(MARKER_CURRENT_OPEN, style=STYLE_BOLD)
            .append(icon, style=style)
            .append(MARKER_CURRENT_CLOSE, style=STYLE_BOLD)
        )

    def get_note(self, target: NoteTarget) -> HunkNote | None:
        """Find a note matching *target*, or None."""
        return next((n for n in self.notes if n.target == target), None)

    def upsert_note(self, kind: NoteKind, target: NoteTarget, text: str) -> None:
        """Insert or update a note for *target*."""
        for i, note in enumerate(self.notes):
            if note.target == target:
                self.notes[i] = HunkNote(kind=kind, target=target, text=text)
                return
        self.notes.append(HunkNote(kind=kind, target=target, text=text))

    def remove_note(self, target: NoteTarget) -> None:
        """Remove the note matching *target*, if any."""
        for i, note in enumerate(self.notes):
            if note.target == target:
                del self.notes[i]
                return

    def build_editor_context(
        self,
        target: NoteTarget,
        scroll_offset: int,
    ) -> list[str]:
        """Build the diff snippet the editor shows above a note on *target*."""
        if isinstance(target, LineTarget):
            target_idx = next(
                (i for i, dl in enumerate(self.display_lines) if dl.target == target),
                None,
            )
            if target_idx is None:
                return []
            start = max(0, target_idx - EDITOR_CONTEXT_RADIUS)
            end = min(len(self.display_lines), target_idx + EDITOR_CONTEXT_RADIUS + 1)
        else:
            start = max(0, scroll_offset)
            end = min(len(self.display_lines), start + EDITOR_HUNK_CONTEXT_MAX)

        lines: list[str] = []
        for dl in self.display_lines[start:end]:
            line_num = format_editor_line_number(dl)
            marker = EDITOR_TARGET_MARKER if dl.target == target else EDITOR_CONTEXT_PAD
            lines.append(f"# {marker} {line_num} {dl.kind.value} {dl.text}")
        return lines


