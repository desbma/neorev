@dataclass
class ReviewState:
    """Mutable state for the interactive review session."""

    hunks: list[Hunk]
    global_notes: list[GlobalNote]
    current_index: int = 0

    @property
    def is_empty(self) -> bool:
        """Return whether the reviewed diff holds no hunk at all."""
        return not self.hunks

    @property
    def current_hunk(self) -> Hunk:
        """Return the hunk the review is on."""
        return self.hunks[self.current_index]

    def find_next_unhandled(self) -> int:
        """Find the next hunk with no review, wrapping around."""
        n = len(self.hunks)
        for offset in range(1, n + 1):
            candidate = (self.current_index + offset) % n
            if not self.hunks[candidate].is_handled:
                return candidate
        return self.current_index

    @staticmethod
    def initial_index(hunks: list[Hunk]) -> int:
        """Return the index of the first unhandled hunk, or 0."""
        return next((i for i, h in enumerate(hunks) if not h.is_handled), 0)

    def move(self, delta: int) -> bool:
        """Shift the current hunk by *delta*, returning True if the index changed."""
        target = min(max(self.current_index + delta, 0), len(self.hunks) - 1)
        if target == self.current_index:
            return False
        self.current_index = target
        return True

    def approve(self) -> None:
        """Toggle approval on the current hunk, ignoring hunks that have notes."""
        hunk = self.hunks[self.current_index]
        if hunk.approved:
            hunk.approved = False
        elif not hunk.notes:
            hunk.approved = True
            self.advance_to_next_unhandled()

    def approve_file(self) -> None:
        """Approve all note-free hunks in the same file as the current hunk."""
        current_file = self.hunks[self.current_index].file_path
        for hunk in self.hunks:
            if hunk.file_path == current_file and not hunk.approved and not hunk.notes:
                hunk.approved = True
        self.advance_to_next_unhandled()

    def advance_to_next_unhandled(self) -> None:
        """Move to the next unhandled hunk."""
        self.current_index = self.find_next_unhandled()

    def adopt(self, other: ReviewState) -> None:
        """Take over the hunks, notes and position of *other*."""
        self.hunks = other.hunks
        self.global_notes = other.global_notes
        self.current_index = other.current_index

    def all_notes(self) -> list[tuple[Hunk, HunkNote] | GlobalNote]:
        """List every note of the review, hunk-scoped ones first."""
        notes: list[tuple[Hunk, HunkNote] | GlobalNote] = [
            (hunk, note) for hunk in self.hunks for note in hunk.notes
        ]
        notes.extend(self.global_notes)
        return notes


@contextmanager
def delta_output(raw: str) -> Iterator[IO[bytes]]:
    """Spawn ``delta`` on *raw* and yield its output stream, reaping it on exit."""
    with tempfile.TemporaryFile() as source:
        source.write(raw.encode())
        source.seek(0)
        with subprocess.Popen(
            DELTA_COMMAND,
            stdin=source,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        ) as process:
            assert process.stdout is not None  # noqa: S101
            try:
                yield process.stdout
            finally:
                if process.poll() is None:
                    process.kill()


@contextmanager
def inotify_events(
    paths: list[str],
) -> Iterator[tuple[subprocess.Popen[bytes], IO[bytes]]]:
    """Watch *paths*, yielding the watcher and its events, reaping it on exit."""
    read_fd, write_fd = os.pipe()
    with (
        os.fdopen(read_fd, "rb") as events,
        os.fdopen(write_fd, "wb") as sink,
        subprocess.Popen(
            ["inotifywait", "-m", "-q", "-e", WATCH_EVENTS, "--", *paths],
            stdin=subprocess.DEVNULL,
            stdout=sink,
            stderr=subprocess.DEVNULL,
        ) as process,
    ):
        sink.close()
        try:
            yield process, events
        finally:
            if process.poll() is None:
                process.terminate()


def format_editor_line_number(dl: DisplayLine) -> str:
    """Render a right-aligned line number for the editor context block."""
    line_num = (
        dl.new_line_number if dl.new_line_number is not None else dl.old_line_number
    )
    if line_num is None:
        return EDITOR_LINE_NUMBER_BLANK
    return f"{line_num:>{EDITOR_LINE_NUMBER_WIDTH}}"


@dataclass(frozen=True)
class FileChange:
    """The paths and status a diff file header describes."""

    path: str
    old_path: str | None
    status: FileStatus


def parse_diff(diff_text: str) -> list[Hunk]:
    """Parse a unified diff into a list of reviewable hunks."""
    hunks: list[Hunk] = []
    for patched_file in unidiff.PatchSet(diff_text.replace("\r\n", "\n")):
        change = resolve_file_change(patched_file)
        if not change.path:
            continue
        file_header = file_header_text(patched_file)
        if not patched_file:
            if change.status is FileStatus.RENAMED:
                hunks.append(rename_hunk(file_header, change))
            continue
        hunks.extend(
            build_hunk(patch_hunk, file_header, change) for patch_hunk in patched_file
        )
    return hunks


def resolve_file_change(patched_file: unidiff.PatchedFile) -> FileChange:
    """Derive the display path, pre-rename path and status of a parsed file."""
    source = strip_diff_prefix(patched_file.source_file or "", DIFF_SOURCE_PREFIX)
    target = strip_diff_prefix(patched_file.target_file or "", DIFF_TARGET_PREFIX)
    if patched_file.target_file == DEV_NULL:
        return FileChange(path=source, old_path=None, status=FileStatus.DELETED)
    if patched_file.source_file == DEV_NULL:
        return FileChange(path=target, old_path=None, status=FileStatus.ADDED)
    info = patched_file.patch_info
    if info is not None and any(line.startswith(RENAME_MARKER) for line in info):
        return FileChange(path=target, old_path=source, status=FileStatus.RENAMED)
    return FileChange(path=target, old_path=None, status=FileStatus.MODIFIED)


def strip_diff_prefix(path: str, prefix: str) -> str:
    """Strip a diff-side prefix from *path*, reaching inside git's quoting."""
    if path.startswith(DIFF_QUOTE) and path.endswith(DIFF_QUOTE):
        return f"{DIFF_QUOTE}{path[1:-1].removeprefix(prefix)}{DIFF_QUOTE}"
    return path.removeprefix(prefix)


def file_header_text(patched_file: unidiff.PatchedFile) -> str:
    """Return the file-header block preceding the hunks of *patched_file*."""
    hunk_text = "".join(str(patch_hunk) for patch_hunk in patched_file)
    return str(patched_file).removesuffix(hunk_text).rstrip("\n")


def build_hunk(
    patch_hunk: unidiff.Hunk,
    file_header: str,
    change: FileChange,
) -> Hunk:
    """Build a reviewable hunk from one parsed diff hunk."""
    lines = [line for line in patch_hunk if line.line_type]
    range_line = hunk_range_line(patch_hunk)
    body = "".join(str(line) for line in lines).rstrip("\n")
    return Hunk(
        range_line=range_line,
        body=body,
        raw=f"{file_header}\n{range_line}\n{body}",
        file_path=change.path,
        file_status=change.status,
        old_path=change.old_path,
        start_line=patch_hunk.target_start,
        display_lines=[display_line(line) for line in lines],
    )


def rename_hunk(file_header: str, change: FileChange) -> Hunk:
    """Build a body-less hunk for a file rename that changes no content."""
    return Hunk(
        range_line="",
        body="",
        raw=file_header,
        file_path=change.path,
        file_status=change.status,
        old_path=change.old_path,
    )


def hunk_range_line(patch_hunk: unidiff.Hunk) -> str:
    """Render the range line of *patch_hunk* in git's unified-diff form."""
    source = format_range(patch_hunk.source_start, patch_hunk.source_length)
    target = format_range(patch_hunk.target_start, patch_hunk.target_length)
    suffix = f" {patch_hunk.section_header}" if patch_hunk.section_header else ""
    return f"{HUNK_RANGE_PREFIX} -{source} +{target} {HUNK_RANGE_PREFIX}{suffix}"


def format_range(start: int, length: int) -> str:
    """Render one side of a range line, omitting the count when it is one."""
    return str(start) if length == SINGLE_LINE_RANGE_LENGTH else f"{start},{length}"


def display_line(line: Line) -> DisplayLine:
    """Map one parsed diff line onto its structured display row."""
    kind = DisplayLineKind(line.line_type)
    target: LineTarget | None = None
    if kind is DisplayLineKind.ADDED:
        if line.target_line_no is None:
            raise MissingLineNumberError
        target = LineTarget(side=LineSide.ADDED, line_number=line.target_line_no)
    elif kind is DisplayLineKind.REMOVED:
        if line.source_line_no is None:
            raise MissingLineNumberError
        target = LineTarget(side=LineSide.REMOVED, line_number=line.source_line_no)
    return DisplayLine(
        kind=kind,
        text=(str(line) if kind is DisplayLineKind.META else line.value).rstrip("\n"),
        old_line_number=line.source_line_no,
        new_line_number=line.target_line_no,
        target=target,
    )


def parse_note_target(text: str) -> NoteTarget | None:
    """Parse a target string back into a NoteTarget."""
    text = text.strip()
    if text == NOTE_TARGET_HUNK:
        return HunkTarget()
    try:
        return LineTarget(side=LineSide(text[0]), line_number=int(text[1:]))
    except (IndexError, ValueError):
        return None


def render_through_delta(diff_text: str) -> list[bytes]:
    """Pipe *diff_text* through ``delta`` and return its output lines (with ANSI)."""
    try:
        result = subprocess.run(
            DELTA_COMMAND,
            input=diff_text.encode(),
            capture_output=True,
            timeout=DELTA_TIMEOUT,
        )
        if result.returncode == 0 and result.stdout.strip():
            return split_delta_output(result.stdout)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return diff_text.encode().split(b"\n")


def split_delta_output(output: bytes) -> list[bytes]:
    """Split ``delta`` *output* into rows, dropping the blank lines framing it."""
    # Only a newline starts a row: bytes.splitlines would also break a row on a
    # bare carriage return, moving every row below it away from the line it draws.
    lines = output.split(b"\n")
    if lines and not lines[-1]:
        lines = lines[:-1]
    if lines and not lines[0]:
        lines = lines[1:]
    return lines


def compute_note_anchor(hunk_body: str, target: NoteTarget) -> str:
    """Return the canonical note anchor string for *hunk_body* and *target*."""
    normalized_body = hunk_body.replace("\r\n", "\n").replace("\r", "\n")
    parts = (ANCHOR_PAYLOAD_VERSION, str(target), normalized_body)
    payload = b"".join(
        len(encoded).to_bytes(ANCHOR_LENGTH_PREFIX_BYTES, "big") + encoded
        for encoded in (part.encode("utf-8") for part in parts)
    )
    digest = hashlib.md5(payload, usedforsecurity=False).digest()
    return (
        base64.urlsafe_b64encode(digest[:ANCHOR_DIGEST_BYTES])
        .rstrip(b"=")
        .decode("ascii")
    )


def format_output(
    hunks: list[Hunk],
    global_notes: list[GlobalNote],
    diff_source: str | None = None,
) -> str:
    """
    Produce compact, unambiguous review output for an LLM agent.

    Approved hunks are omitted.  Each note gets its own section with an
    explicit target (hunk, +N, -N).  Global notes appear first.
    When *diff_source* is provided it is included in the header so the
    agent knows how to retrieve the reviewed diff.
    """
    out = io.StringIO()
    all_notes = [(hunk, note) for hunk in hunks for note in hunk.notes]

    if not all_notes and not global_notes:
        approved = sum(1 for h in hunks if h.approved)
        out.write("# Review: all clear, no action needed.\n")
        if diff_source is not None:
            out.write(f"# Reviewed diff: `{diff_source}`\n")
        out.write(f"# {approved}/{len(hunks)} hunks approved.\n")
        out.write(format_footer(hunks))
        return out.getvalue()

    out.write(OUTPUT_PREAMBLE)
    if diff_source is not None:
        out.write(f"- Reviewed diff: `{diff_source}`\n")

    for note in global_notes:
        write_note_section(out, note.kind, GLOBAL_TARGET, note.text)

    for hunk, hnote in all_notes:
        write_note_section(
            out,
            hnote.kind,
            f"{hunk.file_path}{HEADING_TARGET_SEPARATOR}{hnote.target}",
            hnote.text,
            extras=HunkNoteExtras(
                diff_block=format_diff_block(hunk, hnote),
                anchor=compute_note_anchor(hunk.body, hnote.target),
            ),
        )

    out.write(format_footer(hunks))
    return out.getvalue()


@dataclass(frozen=True)
class HunkNoteExtras:
    """Extra payload written for hunk-scoped note sections."""

    diff_block: str
    anchor: str


def write_note_section(
    out: io.StringIO,
    kind: NoteKind,
    heading: str,
    text: str,
    extras: HunkNoteExtras | None = None,
) -> None:
    """Write a single note section (global or hunk-scoped) to *out*."""
    out.write(f"\n### [{SECTION_KIND_PREFIX}{kind.value}] `{heading}`\n\n")
    if extras is not None:
        out.write(ANCHOR_COMMENT_TEMPLATE.format(value=extras.anchor) + "\n\n")
        out.write(extras.diff_block)
    out.write(text)
    out.write("\n")


def format_diff_block(hunk: Hunk, note: HunkNote) -> str:
    """Format the fenced diff block for a hunk note section."""
    lines = [hunk.range_line, *trim_body_lines(hunk, note)]
    fence = diff_fence(lines)
    return f"{fence}{DIFF_FENCE_INFO}\n" + "\n".join(lines) + f"\n{fence}\n\n"


def diff_fence(lines: list[str]) -> str:
    """Return a code fence longer than every backtick run in *lines*."""
    longest = max(
        (len(run.group()) for line in lines for run in BACKTICK_RUN_RE.finditer(line)),
        default=0,
    )
    return DIFF_FENCE_CHAR * max(DIFF_FENCE_MIN_LENGTH, longest + 1)


def format_footer(hunks: list[Hunk]) -> str:
    """Format the HTML comment footer with approved-hunk hashes."""
    return f"\n<!-- neorev: approved-hashes={encode_approved_hashes(hunks)} -->\n"


def trim_body_lines(hunk: Hunk, note: HunkNote) -> list[str]:
    """Trim long hunk body lines, centering on the target line when applicable."""
    body_lines = hunk.body.splitlines()
    if len(body_lines) <= HUNK_BODY_MAX_LINES:
        return body_lines

    target_index: int | None = None
    if isinstance(note.target, LineTarget):
        body_indices = [i for i, line in enumerate(body_lines) if line]
        for j, dl in enumerate(hunk.display_lines):
            if dl.target == note.target and j < len(body_indices):
                target_index = body_indices[j]
                break

    if target_index is None:
        return [
            *body_lines[:HUNK_BODY_CONTEXT_LINES],
            "# ...",
            *body_lines[-HUNK_BODY_CONTEXT_LINES:],
        ]

    half = HUNK_BODY_MAX_LINES // 2
    start = max(0, min(target_index - half, len(body_lines) - HUNK_BODY_MAX_LINES))
    end = min(len(body_lines), start + HUNK_BODY_MAX_LINES)

    trimmed: list[str] = []
    if start > 0:
        trimmed.append("# ...")
    trimmed.extend(body_lines[start:end])
    if end < len(body_lines):
        trimmed.append("# ...")
    return trimmed


def hunk_identity_hash(hunk: Hunk) -> bytes:
    """Return a fixed-size identity digest for *hunk* based on its content."""
    parts = (hunk.file_path, hunk.range_line, hunk.body)
    payload = b"".join(
        len(encoded).to_bytes(ANCHOR_LENGTH_PREFIX_BYTES, "big") + encoded
        for encoded in (part.encode("utf-8") for part in parts)
    )
    return hashlib.md5(payload, usedforsecurity=False).digest()[:APPROVAL_HASH_BYTES]


def encode_approved_hashes(hunks: list[Hunk]) -> str:
    """Encode the approved hunks as concatenated identity hashes, base64-encoded."""
    chunks = b"".join(hunk_identity_hash(hunk) for hunk in hunks if hunk.approved)
    if not chunks:
        return ""
    return base64.b64encode(chunks).decode("ascii")


def decode_approved_hashes(encoded: str) -> set[bytes]:
    """
    Decode a base64 string of concatenated hunk identity hashes into a set.

    Return an empty set if *encoded* is empty, invalid, or its length is
    not a multiple of the hash size.
    """
    if not encoded:
        return set()
    try:
        raw = base64.b64decode(encoded)
    except (ValueError, binascii.Error):
        return set()
    if len(raw) % APPROVAL_HASH_BYTES != 0:
        return set()
    return {
        raw[i : i + APPROVAL_HASH_BYTES]
        for i in range(0, len(raw), APPROVAL_HASH_BYTES)
    }


def load_previous_review(
    path: str,
) -> tuple[SavedAnnotationMap, list[GlobalNote], str | None]:
    """
    Parse a previous review output file.

    Returns a mapping of ``(file_path, range_line, target) → SavedAnnotation``
    for hunk annotations, a list of ``GlobalNote`` for global ones, and
    the approved-hash encoding (None if absent).
    """
    try:
        text = Path(path).read_text()
    except (FileNotFoundError, OSError):
        return {}, [], None

    if not text.strip():
        return {}, [], None

    annotations: SavedAnnotationMap = {}
    global_notes: list[GlobalNote] = []

    footer_match = FOOTER_RE.search(text)
    approved_encoded = None
    if footer_match is not None:
        approved_encoded = footer_match.group(1)
        text = text[: footer_match.start()]

    for section in SECTION_SPLIT_RE.split(text):
        parse_review_section(section, annotations, global_notes)

    return annotations, global_notes, approved_encoded


def parse_review_section(
    section: str,
    annotations: SavedAnnotationMap,
    global_notes: list[GlobalNote],
) -> None:
    """Parse one ``### ...`` section and populate *annotations* or *global_notes*."""
    header_match = SECTION_HEADER_RE.match(section)
    if header_match is None:
        return

    kind = NoteKind(header_match.group("kind"))
    if header_match.group("global") is not None:
        comment = section[header_match.end() :].strip()
        if comment:
            global_notes.append(GlobalNote(kind=kind, text=comment))
        return

    block_match = DIFF_BLOCK_RE.search(section, header_match.end())
    if block_match is None:
        return
    range_line = block_match.group("body").partition("\n")[0]
    if range_line and not range_line.startswith(HUNK_RANGE_PREFIX):
        return

    target: NoteTarget = HunkTarget()
    parsed = parse_note_target(header_match.group("target"))
    if parsed is not None:
        target = parsed

    anchor_match = ANCHOR_COMMENT_RE.search(
        section, header_match.end(), block_match.start()
    )
    annotations[(header_match.group("path"), range_line, target)] = SavedAnnotation(
        kind=kind,
        text=section[block_match.end() :].strip(),
        anchor=anchor_match.group(1) if anchor_match else None,
    )


def line_target_exists(hunk: Hunk, target: LineTarget) -> bool:
    """Return whether *target* still corresponds to a line in *hunk*."""
    return any(dl.target == target for dl in hunk.display_lines)


def apply_previous_review(
    hunks: list[Hunk],
    annotations: SavedAnnotationMap,
) -> ApplyResult:
    """
    Apply previously saved annotations to *hunks*, validating each anchor.

    Returns counters describing matched and stale annotations. An annotation
    is dropped when its tuple key has no current hunk, when its line target
    no longer exists in the current hunk, or when its anchor is missing or
    differs from the recomputed value.
    """
    lookup: dict[tuple[str, str], Hunk] = {}
    for hunk in hunks:
        lookup[(hunk.file_path, hunk.range_line)] = hunk

    matched = 0
    stale_unmatched = 0
    stale_anchor = 0
    stale_missing_target = 0
    for (file_path, range_line, target), saved in annotations.items():
        hunk = lookup.get((file_path, range_line))
        if hunk is None:
            stale_unmatched += 1
            continue
        if isinstance(target, LineTarget) and not line_target_exists(hunk, target):
            stale_missing_target += 1
            continue
        if compute_note_anchor(hunk.body, target) != saved.anchor:
            stale_anchor += 1
            continue
        hunk.upsert_note(saved.kind, target, saved.text)
        matched += 1
    return ApplyResult(
        matched=matched,
        stale_unmatched=stale_unmatched,
        stale_anchor=stale_anchor,
        stale_missing_target=stale_missing_target,
    )


def write_comment_template(
    file_obj: IO[str],
    location: str,
    existing: str,
    context_lines: list[str] | None = None,
) -> int:
    """
    Write the comment template into *file_obj*.

    Returns the editor jump-line number (1-indexed).
    """
    file_obj.write(f"# Comment for {location}\n")
    file_obj.write("# Lines starting with # are stripped.\n")
    header_count = 2
    if context_lines:
        file_obj.write("#\n")
        file_obj.writelines(f"{ctx}\n" for ctx in context_lines)
        file_obj.write("#\n")
        header_count += len(context_lines) + 2
    file_obj.write("\n")
    if existing:
        file_obj.write(existing)
    file_obj.write("\n")
    content_lines = existing.count("\n") + 1 if existing else 1
    return header_count + 1 + content_lines  # header + blank + content


def read_comment_file(path: str) -> str:
    """Read a comment file, stripping lines that start with ``#``."""
    with open(path) as f:
        lines = [line for line in f if not line.startswith("#")]
    return "".join(lines).strip()


def erase_fill_style(line: str) -> Style | None:
    """Return the style active at *line*'s erase-to-end-of-line sequence, if any."""
    prefix, separator, _ = line.partition(ERASE_TO_LINE_END)
    if not separator:
        return None
    probed = Text.from_ansi(prefix + STYLE_PROBE_CHAR)
    return probed.get_style_at_offset(CONSOLE, -1)


def build_margin_markers(hunk: Hunk) -> list[str]:
    """Build the note-icon margin prefix of each display line of *hunk*, if any."""
    if not any(isinstance(note.target, LineTarget) for note in hunk.notes):
        return []
    markers: list[str] = []
    for dl in hunk.display_lines:
        note = hunk.get_note(dl.target) if dl.target is not None else None
        markers.append(f"{note.kind.icon} " if note is not None else MARGIN_EMPTY)
    return markers


def background_start(text: Text) -> int:
    """Return the offset of the first character *text* paints a background under."""
    return min(
        (
            span.start
            for span in text.spans
            if CONSOLE.get_style(span.style).bgcolor is not None
        ),
        default=len(text),
    )


def diff_line_text(line: bytes, margin: str = "") -> Text:
    """Build the renderable of one ``delta`` output *line*, prefixed with *margin*."""
    decoded = line.decode("utf-8", errors="replace")
    body = Text.from_ansi(decoded)
    text = Text(margin).append_text(body)
    text.justify = "left"
    fill = erase_fill_style(decoded)
    if fill is not None:
        text.style = fill
        text.stylize(STYLE_NO_FILL, 0, len(margin) + background_start(body))
    return text


def render_hunk_lines(lines: list[bytes], markers: list[str]) -> list[Text]:
    """Build the renderable of every ``delta`` output line, under its margin marker."""
    return [
        diff_line_text(line, markers[index] if index < len(markers) else "")
        for index, line in enumerate(lines)
    ]


def pad_to_width(text: Text, width: int) -> Text:
    """Pad *text* with blanks up to *width* columns, in the style it carries."""
    text.pad_right(max(0, width - text.cell_len))
    return text


def initial_picker_line(hunk: Hunk, scroll_offset: int) -> int:
    """Return the display index of the first selectable line at or below the scroll."""
    selectable = [i for i, dl in enumerate(hunk.display_lines) if dl.target is not None]
    if not selectable:
        return 0
    return next((i for i in selectable if i >= scroll_offset), selectable[0])


def build_progress_hunk_segment(state: ReviewState) -> Text:
    """Build the 'Hunk N/M' segment with a progress fill."""
    total = len(state.hunks)
    handled = sum(1 for hunk in state.hunks if hunk.is_handled)
    label = f" Hunk {state.current_index + 1}/{total} "
    filled = len(label) * handled // total
    segment = Text("│")
    segment.append(label[:filled], style=STYLE_PROGRESS_FILL)
    segment.append(label[filled:])
    segment.append("│")
    return segment


def build_top_bar(state: ReviewState, term_width: int) -> Text:
    """Build the top status bar for the current hunk."""
    hunk = state.current_hunk
    bar = Text().append(BRAND_LABEL, style=STYLE_BRAND)
    bar.append_text(build_progress_hunk_segment(state))
    bar.append(" ")
    bar.append_text(hunk.file_status.marker)
    bar.append(" ")
    bar.append(hunk.location_label, style=STYLE_BOLD)
    bar.append(build_top_bar_counters(state.hunks, state.global_notes))
    if bar.cell_len > term_width:
        bar.truncate(term_width, overflow="ellipsis")
    return bar


def build_top_bar_counters(
    hunks: list[Hunk],
    global_notes: list[GlobalNote],
) -> str:
    """Build the compact note-count segment for the top bar."""
    counts: Counter[tuple[type, NoteKind]] = Counter(
        (type(note.target), note.kind) for hunk in hunks for note in hunk.notes
    )
    global_counts: Counter[NoteKind] = Counter(n.kind for n in global_notes)
    parts = [
        f"global {NoteKind.FLAG.icon} {global_counts[NoteKind.FLAG]}"
        f" {NoteKind.QUESTION.icon} {global_counts[NoteKind.QUESTION]}",
        f"hunk {NoteKind.FLAG.icon} {counts[(HunkTarget, NoteKind.FLAG)]}"
        f" {NoteKind.QUESTION.icon} {counts[(HunkTarget, NoteKind.QUESTION)]}",
        f"line {NoteKind.FLAG.icon} {counts[(LineTarget, NoteKind.FLAG)]}"
        f" {NoteKind.QUESTION.icon} {counts[(LineTarget, NoteKind.QUESTION)]}",
    ]
    return "  │ " + " │ ".join(parts)


def marker_window(state: ReviewState, available: int) -> tuple[int, int]:
    """Return the hunk range the marker line shows within *available* columns."""
    total = len(state.hunks)
    if available // MARKER_WIDTH >= total:
        return 0, total

    slots = max(1, (available - ARROW_WIDTH * 2) // MARKER_WIDTH)
    start = max(0, min(state.current_index - slots // 2, total - slots))
    # One-sided overflow leaves room for one arrow only, hence more markers.
    if start == 0 or start + slots == total:
        slots = max(1, (available - ARROW_WIDTH) // MARKER_WIDTH)
        start = max(0, min(state.current_index - slots // 2, total - slots))
    return start, start + slots


def build_progress_markers(state: ReviewState, term_width: int) -> Text:
    """Build the hunk progress marker line, with overflow arrows."""
    prefix = "  "
    available = term_width - len(prefix)
    if available < MARKER_WIDTH:
        return Text()
    start, end = marker_window(state, available)

    line = Text(prefix)
    if start > 0:
        line.append("◀ ", style=STYLE_DIM)
    for index in range(start, end):
        line.append_text(
            state.hunks[index].marker(is_current=index == state.current_index)
        )
    if end < len(state.hunks):
        line.append(" ▶", style=STYLE_DIM)
    return line


def note_option_text(entry: tuple[Hunk, HunkNote] | GlobalNote) -> Text:
    """Build the note list prompt naming and quoting one note."""
    if isinstance(entry, GlobalNote):
        scope, note = GLOBAL_TARGET, entry
    else:
        hunk, note = entry
        scope = f"{hunk.short_location}{HEADING_TARGET_SEPARATOR}{note.target}"
    prompt = Text(f"{note.kind.icon} ")
    prompt.append(scope, style=STYLE_DIM)
    prompt.append(f"\n{note.text}")
    return prompt


def edit_comment_in_editor(
    existing: str,
    location: str,
    context_lines: list[str] | None = None,
) -> str:
    """Open ``$EDITOR`` on a temporary file pre-filled with *existing*."""
    with tempfile.TemporaryDirectory(prefix="review-") as tmpdir:
        tmppath = str(Path(tmpdir) / "comment.cfg")
        with open(tmppath, "w") as tmp:
            jump_line = write_comment_template(tmp, location, existing, context_lines)
        with open(TTY_DEVICE, "r+b", buffering=0) as terminal:
            subprocess.run(
                [os.environ["EDITOR"], f"{tmppath}:{jump_line}"],
                check=True,
                stdin=terminal,
                stdout=terminal,
                stderr=terminal,
            )
        return read_comment_file(tmppath)


class TtyDriver(LinuxDriver):
    """Driver reading its keys from, and drawing on, the controlling terminal."""

    def __init__(
        self,
        app: App[object],
        *,
        debug: bool = False,
        mouse: bool = True,
        size: tuple[int, int] | None = None,
    ) -> None:
        """Declare the input a terminal, whatever standard input happens to be."""
        super().__init__(app, debug=debug, mouse=mouse, size=size)
        self.tty_file: IO[str] | None = None
        self.input_tty = True

    def start_application_mode(self) -> None:
        """Open the controlling terminal, then enter application mode on it."""
        # Held open for the whole session; released in close().
        raw = open(TTY_DEVICE, "r+b", buffering=0)  # noqa: SIM115
        self.tty_file = io.TextIOWrapper(raw, encoding="utf-8", write_through=True)
        self.fileno = self.tty_file.fileno()
        self._file = self.tty_file
        super().start_application_mode()
        self.write(ALTERNATE_SCROLL_OFF)
        self.flush()

    def stop_application_mode(self) -> None:
        """Leave application mode, handing the wheel back to the terminal."""
        super().stop_application_mode()
        self.write(ALTERNATE_SCROLL_ON)
        self.flush()

    def close(self) -> None:
        """Leave application mode and release the controlling terminal."""
        super().close()
        if self.tty_file is not None:
            self.tty_file.close()
            self.tty_file = None

    def _get_terminal_size(self) -> tuple[int, int]:
        """Read the geometry of the controlling terminal."""
        size = os.get_terminal_size(self.fileno)
        return size.columns, size.lines


class Chrome(Static):
    """Status line drawn from the review state."""

    def __init__(self, state: ReviewState) -> None:
        """Store the review *state* the chrome draws from."""
        super().__init__()
        self.state = state


class TopBar(Chrome):
    """Bar naming the current hunk, its file and the note counters."""

    def render(self) -> RenderResult:
        """Draw the bar for the hunk the review is on."""
        if self.state.is_empty:
            return Text()
        return build_top_bar(self.state, self.size.width)


class Markers(Chrome):
    """Line of one marker per hunk, showing what is left to review."""

    def render(self) -> RenderResult:
        """Draw the marker of every hunk that fits."""
        if self.state.is_empty:
            return Text()
        return build_progress_markers(self.state, self.size.width)


class HiddenRows(Label):
    """Count of the rows a scrolling view keeps past one of its edges."""

    def __init__(self, scroller: ScrollView, edge: ScrollEdge) -> None:
        """Count the rows *scroller* keeps past its *edge*."""
        super().__init__()
        self.scroller = scroller
        self.edge = edge

    def on_mount(self) -> None:
        """Follow the scroll position, the content and the height of the view."""
        self.watch(self.scroller, "scroll_y", self.follow_view)
        self.watch(self.scroller, "virtual_size", self.follow_view)
        # Only the scrollbar publishes the height of the view as a reactive.
        self.watch(self.scroller.vertical_scrollbar, "window_size", self.follow_view)

    def follow_view(self) -> None:
        """Redraw the count, shown while the view keeps rows past its edge."""
        self.display = self.rows() > 0
        self.refresh(layout=True)

    def rows(self) -> int:
        """Return how many rows the view keeps past the edge counted."""
        if not self.scroller.display:
            return 0
        above = self.scroller.scroll_offset.y
        if self.edge is ScrollEdge.ABOVE:
            return above
        return self.scroller.max_scroll_y - above

    def render(self) -> RenderResult:
        """Draw how many rows the edge hides, then the arrow pointing at them."""
        return Text(f"{self.rows()}{self.edge.value}")


class MarkerRow(Horizontal):
