class DeltaStream:
    """Streams delta output incrementally, caching lines for reuse."""

    def __init__(self, raw: str, width: int) -> None:
        """Spawn a delta process on *raw* and prepare for incremental reads."""
        self.lines: list[bytes] = []
        self.buf: bytes = b""
        self.exhausted: bool = False
        self.leading_stripped: bool = False
        self.process: subprocess.Popen[bytes] = subprocess.Popen(
            [
                "delta",
                "--width",
                str(width),
                "--file-style",
                "omit",
                "--hunk-header-style",
                "omit",
                "--paging",
                "never",
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        self.feeder: threading.Thread = threading.Thread(
            target=feed_pipe,
            args=(self.process.stdin, raw.encode()),
            daemon=True,
        )
        self.feeder.start()

    def ensure_lines(self, count: int) -> None:
        """Read from the pipe until at least *count* lines are cached or stream ends."""
        while len(self.lines) < count and not self.exhausted:
            self.read_chunk()

    def read_all(self) -> list[bytes]:
        """Drain all remaining output and return every cached line."""
        while not self.exhausted:
            self.read_chunk()
        return self.lines

    def read_chunk(self) -> None:
        """Read one chunk from stdout and append complete lines to the cache."""
        if self.process.stdout is None:
            self.exhausted = True
            return
        chunk = self.process.stdout.read(DELTA_STREAM_READ_SIZE)
        if not chunk:
            if self.buf:
                self.lines.append(self.buf)
                self.buf = b""
            self.exhausted = True
            self.process.stdout.close()
            self.process.wait()
            if self.lines and self.lines[-1] == b"":
                self.lines.pop()
            return
        self.buf += chunk
        parts = self.buf.split(b"\n")
        self.buf = parts[-1]
        self.lines.extend(parts[:-1])
        if not self.leading_stripped and self.lines and self.lines[0] == b"":
            self.lines.pop(0)
            self.leading_stripped = True

    def get_output(self, line_count: int) -> bytes:
        """Read at least *line_count* lines, then join every cached line as bytes."""
        self.ensure_lines(line_count)
        return b"\n".join(self.lines)

    def kill(self) -> None:
        """Terminate the delta process and join the feeder thread."""
        if self.process.poll() is None:
            self.process.kill()
            if self.process.stdout is not None:
                self.process.stdout.close()
            self.process.wait()
        self.feeder.join()


def feed_pipe(pipe: IO[bytes], data: bytes) -> None:
    """Write *data* into *pipe* and close it, swallowing broken-pipe errors."""
    with closing(pipe), suppress(BrokenPipeError):
        pipe.write(data)


def format_editor_line_number(dl: DisplayLine) -> str:
    """Render a right-aligned line number for the editor context block."""
    line_num = (
        dl.new_line_number if dl.new_line_number is not None else dl.old_line_number
    )
    if line_num is None:
        return EDITOR_LINE_NUMBER_BLANK
    return f"{line_num:>{EDITOR_LINE_NUMBER_WIDTH}}"


@dataclass
class FileHeader:
    """A parsed diff file-header block and the file change it introduces."""

    text: str
    path: str | None
    old_path: str | None
    status: FileStatus


def parse_diff(diff_text: str) -> list[Hunk]:
    """Parse a unified diff into a list of reviewable hunks."""
    hunks: list[Hunk] = []
    lines = diff_text.splitlines(keepends=True)
    header: FileHeader | None = None
    i = 0

    while i < len(lines):
        line = lines[i]

        if line.startswith(("diff --git", "diff ")):
            header, i = parse_file_header(lines, i, header.path if header else None)
            if header.status is FileStatus.RENAMED and (
                i >= len(lines) or not lines[i].startswith(HUNK_RANGE_PREFIX)
            ):
                hunks.append(make_rename_hunk(header))
            continue

        if line.startswith(HUNK_RANGE_PREFIX):
            hunk, i = parse_hunk_body(lines, i, header)
            hunks.append(hunk)
            continue

        i += 1

    return hunks


def parse_file_header(
    lines: list[str],
    start: int,
    fallback_path: str | None,
) -> tuple[FileHeader, int]:
    """
    Parse a diff file header block starting at *start*.

    Returns (FileHeader, next_line_index).
    """
    header_lines = [lines[start]]
    i = start + 1
    source_path: str | None = None
    dest_path: str | None = None
    renamed = False
    while (
        i < len(lines)
        and not lines[i].startswith(HUNK_RANGE_PREFIX)
        and not lines[i].startswith("diff ")
    ):
        line = lines[i]
        header_lines.append(line)
        if line.startswith("--- "):
            source_path = line[4:].strip().removeprefix("a/")
        elif line.startswith("+++ "):
            dest_path = line[4:].strip().removeprefix("b/")
        elif line.startswith("rename from "):
            renamed = True
            source_path = line[len("rename from ") :].strip()
        elif line.startswith("rename to "):
            renamed = True
            dest_path = line[len("rename to ") :].strip()
        i += 1
    text = "".join(header_lines).rstrip("\n")
    path, old_path, status = resolve_file_change(
        source_path, dest_path, fallback_path, renamed=renamed
    )
    return FileHeader(text=text, path=path, old_path=old_path, status=status), i


def resolve_file_change(
    source_path: str | None,
    dest_path: str | None,
    fallback_path: str | None,
    *,
    renamed: bool,
) -> tuple[str | None, str | None, FileStatus]:
    """Derive the display path, pre-rename path, and status from header endpoints."""
    if dest_path == "/dev/null":
        return source_path, None, FileStatus.DELETED
    if source_path == "/dev/null":
        return dest_path, None, FileStatus.ADDED
    path = dest_path if dest_path is not None else fallback_path
    if renamed:
        return path, source_path, FileStatus.RENAMED
    return path, None, FileStatus.MODIFIED


def make_rename_hunk(header: FileHeader) -> Hunk:
    """Build a body-less hunk for a file rename that changes no content."""
    return Hunk(
        file_header=header.text,
        range_line="",
        body="",
        raw=header.text,
        file_path=header.path,
        file_status=header.status,
        old_path=header.old_path,
    )


def parse_hunk_body(
    lines: list[str],
    start: int,
    header: FileHeader | None,
) -> tuple[Hunk, int]:
    """
    Parse a single @@ hunk starting at *start*.

    Returns (Hunk, next_line_index).
    """
    range_line = lines[start].rstrip("\r\n")
    match = re.search(r"\+(\d+)", range_line)
    start_line = int(match.group(1)) if match else None

    body_lines: list[str] = []
    i = start + 1
    while (
        i < len(lines)
        and not lines[i].startswith(HUNK_RANGE_PREFIX)
        and not lines[i].startswith("diff ")
    ):
        body_lines.append(lines[i])
        i += 1

    body = "".join(body_lines).rstrip("\n")
    file_header = header.text if header is not None else None
    raw = (
        f"{file_header}\n{range_line}\n{body}"
        if file_header
        else f"{range_line}\n{body}"
    )

    hunk = Hunk(
        file_header=file_header,
        range_line=range_line,
        body=body,
        raw=raw,
        file_path=header.path if header is not None else None,
        file_status=header.status if header is not None else FileStatus.MODIFIED,
        old_path=header.old_path if header is not None else None,
        start_line=start_line,
        display_lines=parse_display_lines(range_line, body),
    )
    return hunk, i


def parse_display_lines(range_line: str, body: str) -> list[DisplayLine]:
    """Parse a hunk body into structured display rows with line numbers."""
    match = HUNK_RANGE_LINE_RE.match(range_line)
    if not match:
        return []
    old_num = int(match.group("old_start"))
    new_num = int(match.group("new_start"))

    result: list[DisplayLine] = []
    for line in body.splitlines():
        if not line:
            continue
        try:
            line_kind = DisplayLineKind(line[0])
        except ValueError:
            line_kind = DisplayLineKind.CONTEXT

        if line_kind is DisplayLineKind.META:
            result.append(
                DisplayLine(
                    kind=line_kind,
                    text=line,
                    old_line_number=None,
                    new_line_number=None,
                    target=None,
                )
            )
            continue

        text = line[1:] if len(line) > 1 else ""
        target: LineTarget | None = None
        if line_kind is DisplayLineKind.ADDED:
            target = LineTarget(side=LineSide.ADDED, line_number=new_num)
        elif line_kind is DisplayLineKind.REMOVED:
            target = LineTarget(side=LineSide.REMOVED, line_number=old_num)

        result.append(
            DisplayLine(
                kind=line_kind,
                text=text,
                old_line_number=(
                    old_num if line_kind is not DisplayLineKind.ADDED else None
                ),
                new_line_number=(
                    new_num if line_kind is not DisplayLineKind.REMOVED else None
                ),
                target=target,
            )
        )
        if line_kind is not DisplayLineKind.ADDED:
            old_num += 1
        if line_kind is not DisplayLineKind.REMOVED:
            new_num += 1
    return result


def parse_note_target(text: str) -> NoteTarget | None:
    """Parse a target string back into a NoteTarget."""
    text = text.strip()
    if text == NOTE_TARGET_HUNK:
        return HunkTarget()
    if text:
        try:
            side = LineSide(text[0])
        except ValueError:
            return None
        try:
            line_number = int(text[1:])
            return LineTarget(side=side, line_number=line_number)
        except ValueError:
            return None
    return None


def render_through_delta(diff_text: str, width: int = 120) -> bytes:
    """Pipe *diff_text* through ``delta`` and return raw bytes (with ANSI)."""
    try:
        result = subprocess.run(
            [
                "delta",
                "--width",
                str(width),
                "--file-style",
                "omit",
                "--hunk-header-style",
                "omit",
                "--paging",
                "never",
            ],
            input=diff_text.encode(),
            capture_output=True,
            timeout=5,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    return diff_text.encode()


def compute_note_anchor(hunk_body: str, target: NoteTarget) -> str:
    """Return the canonical note anchor string for *hunk_body* and *target*."""
    normalized_body = hunk_body.replace("\r\n", "\n").replace("\r", "\n")
    parts = (ANCHOR_PAYLOAD_VERSION, str(target), normalized_body)
    payload = b"".join(
        len(encoded).to_bytes(ANCHOR_LENGTH_PREFIX_BYTES, "big") + encoded
        for encoded in (part.encode("utf-8") for part in parts)
    )
    digest = hashlib.md5(payload, usedforsecurity=False).digest()
    return (
        base64.urlsafe_b64encode(digest[:ANCHOR_DIGEST_BYTES])
        .rstrip(b"=")
        .decode("ascii")
    )


def format_output(
    hunks: list[Hunk],
    global_notes: list[GlobalNote],
    diff_source: str | None = None,
) -> str:
    """
    Produce compact, unambiguous review output for an LLM agent.

    Approved hunks are omitted.  Each note gets its own section with an
    explicit target (hunk, +N, -N).  Global notes appear first.
    When *diff_source* is provided it is included in the header so the
    agent knows how to retrieve the reviewed diff.
    """
    out = StringIO()
    all_notes = [(hunk, note) for hunk in hunks for note in hunk.notes]

    if not all_notes and not global_notes:
        approved = sum(1 for h in hunks if h.approved)
        out.write("# Review: all clear, no action needed.\n")
        if diff_source is not None:
            out.write(f"# Reviewed diff: `{diff_source}`\n")
        out.write(f"# {approved}/{len(hunks)} hunks approved.\n")
        out.write(format_footer(hunks))
        return out.getvalue()

    out.write(OUTPUT_PREAMBLE)
    if diff_source is not None:
        out.write(f"- Reviewed diff: `{diff_source}`\n")

    for note in global_notes:
        write_note_section(out, note.kind, GLOBAL_TARGET, note.text)

    for hunk, hnote in all_notes:
        write_note_section(
            out,
            hnote.kind,
            f"{hunk_identity_path(hunk)}{HEADING_TARGET_SEPARATOR}{hnote.target}",
            hnote.text,
            extras=HunkNoteExtras(
                diff_block=format_diff_block(hunk, hnote),
                anchor=compute_note_anchor(hunk.body, hnote.target),
            ),
        )

    out.write(format_footer(hunks))
    return out.getvalue()


@dataclass(frozen=True)
class HunkNoteExtras:
    """Extra payload written for hunk-scoped note sections."""

    diff_block: str
    anchor: str


def write_note_section(
    out: StringIO,
    kind: NoteKind,
    heading: str,
    text: str,
    extras: HunkNoteExtras | None = None,
) -> None:
    """Write a single note section (global or hunk-scoped) to *out*."""
    out.write(f"\n### [{SECTION_KIND_PREFIX}{kind.value}] `{heading}`\n\n")
    if extras is not None:
        out.write(ANCHOR_COMMENT_TEMPLATE.format(value=extras.anchor) + "\n\n")
        out.write(extras.diff_block)
    out.write(text)
    out.write("\n")


def format_diff_block(hunk: Hunk, note: HunkNote) -> str:
    """Format the fenced diff block for a hunk note section."""
    lines = [hunk.range_line, *trim_body_lines(hunk, note)]
    fence = diff_fence(lines)
    return f"{fence}{DIFF_FENCE_INFO}\n" + "\n".join(lines) + f"\n{fence}\n\n"


def diff_fence(lines: list[str]) -> str:
    """Return a code fence longer than every backtick run in *lines*."""
    longest = max(
        (len(run.group()) for line in lines for run in BACKTICK_RUN_RE.finditer(line)),
        default=0,
    )
    return DIFF_FENCE_CHAR * max(DIFF_FENCE_MIN_LENGTH, longest + 1)


def format_footer(hunks: list[Hunk]) -> str:
    """Format the HTML comment footer with approved-hunk hashes."""
    return f"\n<!-- neorev: approved-hashes={encode_approved_hashes(hunks)} -->\n"


def trim_body_lines(hunk: Hunk, note: HunkNote) -> list[str]:
    """Trim long hunk body lines, centering on the target line when applicable."""
    body_lines = hunk.body.splitlines()
    if len(body_lines) <= HUNK_BODY_MAX_LINES:
        return body_lines

    target_index: int | None = None
    if isinstance(note.target, LineTarget):
        body_indices = [i for i, line in enumerate(body_lines) if line]
        for j, dl in enumerate(hunk.display_lines):
            if dl.target == note.target and j < len(body_indices):
                target_index = body_indices[j]
                break

    if target_index is None:
        return [
            *body_lines[:HUNK_BODY_CONTEXT_LINES],
            "# ...",
            *body_lines[-HUNK_BODY_CONTEXT_LINES:],
        ]

    half = HUNK_BODY_MAX_LINES // 2
    start = max(0, min(target_index - half, len(body_lines) - HUNK_BODY_MAX_LINES))
    end = min(len(body_lines), start + HUNK_BODY_MAX_LINES)

    trimmed: list[str] = []
    if start > 0:
        trimmed.append("# ...")
    trimmed.extend(body_lines[start:end])
    if end < len(body_lines):
        trimmed.append("# ...")
    return trimmed


def hunk_identity_path(hunk: Hunk) -> str:
    """Return the string identifying *hunk* in a review file."""
    return hunk.file_path if hunk.file_path is not None else hunk.range_line


def hunk_identity_hash(hunk: Hunk) -> bytes:
    """Return a fixed-size identity digest for *hunk* based on its content."""
    parts = (hunk.file_path or "", hunk.range_line, hunk.body)
    payload = b"".join(
        len(encoded).to_bytes(ANCHOR_LENGTH_PREFIX_BYTES, "big") + encoded
        for encoded in (part.encode("utf-8") for part in parts)
    )
    return hashlib.md5(payload, usedforsecurity=False).digest()[:APPROVAL_HASH_BYTES]


def encode_approved_hashes(hunks: list[Hunk]) -> str:
    """Encode the approved hunks as concatenated identity hashes, base64-encoded."""
    chunks = b"".join(hunk_identity_hash(hunk) for hunk in hunks if hunk.approved)
    if not chunks:
        return ""
    return base64.b64encode(chunks).decode("ascii")


def decode_approved_hashes(encoded: str) -> set[bytes]:
    """
    Decode a base64 string of concatenated hunk identity hashes into a set.

    Return an empty set if *encoded* is empty, invalid, or its length is
    not a multiple of the hash size.
    """
    if not encoded:
        return set()
    try:
        raw = base64.b64decode(encoded)
    except (ValueError, binascii.Error):
        return set()
    if len(raw) % APPROVAL_HASH_BYTES != 0:
        return set()
    return {
        raw[i : i + APPROVAL_HASH_BYTES]
        for i in range(0, len(raw), APPROVAL_HASH_BYTES)
    }


def load_previous_review(
    path: str,
) -> tuple[SavedAnnotationMap, list[GlobalNote], str | None]:
    """
    Parse a previous review output file.

    Returns a mapping of ``(file_path, range_line, target) → SavedAnnotation``
    for hunk annotations, a list of ``GlobalNote`` for global ones, and
    the approved-hash encoding (None if absent).
    """
    try:
        text = Path(path).read_text()
    except (FileNotFoundError, OSError):
        return {}, [], None

    if not text.strip():
        return {}, [], None

    annotations: SavedAnnotationMap = {}
    global_notes: list[GlobalNote] = []

    footer_match = FOOTER_RE.search(text)
    approved_encoded = None
    if footer_match is not None:
        approved_encoded = footer_match.group(1)
        text = text[: footer_match.start()]

    for section in SECTION_SPLIT_RE.split(text):
        parse_review_section(section, annotations, global_notes)

    return annotations, global_notes, approved_encoded


def parse_review_section(
    section: str,
    annotations: SavedAnnotationMap,
    global_notes: list[GlobalNote],
) -> None:
    """Parse one ``### ...`` section and populate *annotations* or *global_notes*."""
    header_match = SECTION_HEADER_RE.match(section)
    if header_match is None:
        return

    kind = NoteKind(header_match.group("kind"))
    if header_match.group("global") is not None:
        comment = section[header_match.end() :].strip()
        if comment:
            global_notes.append(GlobalNote(kind=kind, text=comment))
        return

    block_match = DIFF_BLOCK_RE.search(section, header_match.end())
    if block_match is None:
        return
    range_line = block_match.group("body").partition("\n")[0]
    if range_line and not range_line.startswith(HUNK_RANGE_PREFIX):
        return

    target: NoteTarget = HunkTarget()
    parsed = parse_note_target(header_match.group("target"))
    if parsed is not None:
        target = parsed

    anchor_match = ANCHOR_COMMENT_RE.search(
        section, header_match.end(), block_match.start()
    )
    annotations[(header_match.group("path"), range_line, target)] = SavedAnnotation(
        kind=kind,
        text=section[block_match.end() :].strip(),
        anchor=anchor_match.group(1) if anchor_match else None,
    )


def line_target_exists(hunk: Hunk, target: LineTarget) -> bool:
    """Return whether *target* still corresponds to a line in *hunk*."""
    return any(dl.target == target for dl in hunk.display_lines)


def apply_previous_review(
    hunks: list[Hunk],
    annotations: SavedAnnotationMap,
) -> ApplyResult:
    """
    Apply previously saved annotations to *hunks*, validating each anchor.

    Returns counters describing matched and stale annotations. An annotation
    is dropped when its tuple key has no current hunk, when its line target
    no longer exists in the current hunk, or when its anchor is missing or
    differs from the recomputed value.
    """
    lookup: dict[tuple[str, str], Hunk] = {}
    for hunk in hunks:
        lookup[(hunk_identity_path(hunk), hunk.range_line)] = hunk

    matched = 0
    stale_unmatched = 0
    stale_anchor = 0
    stale_missing_target = 0
    for (file_path, range_line, target), saved in annotations.items():
        hunk = lookup.get((file_path, range_line))
        if hunk is None:
            stale_unmatched += 1
            continue
        if isinstance(target, LineTarget) and not line_target_exists(hunk, target):
            stale_missing_target += 1
            continue
        if compute_note_anchor(hunk.body, target) != saved.anchor:
            stale_anchor += 1
            continue
        hunk.upsert_note(saved.kind, target, saved.text)
        matched += 1
    return ApplyResult(
        matched=matched,
        stale_unmatched=stale_unmatched,
        stale_anchor=stale_anchor,
        stale_missing_target=stale_missing_target,
    )


def write_comment_template(
    file_obj: IO[str],
    location: str,
    existing: str,
    context_lines: list[str] | None = None,
) -> int:
    """
    Write the comment template into *file_obj*.

    Returns the editor jump-line number (1-indexed).
    """
    file_obj.write(f"# Comment for {location}\n")
    file_obj.write("# Lines starting with # are stripped.\n")
    header_count = 2
    if context_lines:
        file_obj.write("#\n")
        file_obj.writelines(f"{ctx}\n" for ctx in context_lines)
        file_obj.write("#\n")
        header_count += len(context_lines) + 2
    file_obj.write("\n")
    if existing:
        file_obj.write(existing)
    file_obj.write("\n")
    content_lines = existing.count("\n") + 1 if existing else 1
    return header_count + 1 + content_lines  # header + blank + content


def read_comment_file(path: str) -> str:
    """Read a comment file, stripping lines that start with ``#``."""
    with open(path) as f:
        lines = [line for line in f if not line.startswith("#")]
    return "".join(lines).strip()


@contextmanager
def duplicated_fd(fd: int) -> Iterator[int]:
    """Yield a duplicate of *fd* and close it automatically."""
    dup_fd = os.dup(fd)
    try:
        yield dup_fd
    finally:
        os.close(dup_fd)


@contextmanager
def nonblocking_pipe() -> Iterator[tuple[int, int]]:
    """Yield a non-blocking pipe pair and close both ends automatically."""
    read_fd, write_fd = os.pipe()
    try:
        os.set_blocking(read_fd, False)
        os.set_blocking(write_fd, False)
        yield read_fd, write_fd
    finally:
        os.close(read_fd)
        os.close(write_fd)


def visible_width(text: str) -> int:
    """Return the terminal column count of *text* (ignoring ANSI escapes)."""
    return Text.from_ansi(text).cell_len


def erase_fill_style(line: str) -> Style | None:
    """Return the style active at *line*'s erase-to-end-of-line sequence, if any."""
    prefix, separator, _ = line.partition(ERASE_TO_LINE_END)
    if not separator:
        return None
    probed = Text.from_ansi(prefix + STYLE_PROBE_CHAR)
    return probed.get_style_at_offset(CONSOLE, -1)


def render_ansi_text(
    text: Text, width: int | None = None, pad_style: Style | None = None
) -> str:
    """Render *text* as an ANSI string, padded to *width* with *pad_style*."""
    segments = list(text.render(CONSOLE))
    if width is not None:
        fill = (
            pad_style
            if pad_style is not None
            else next((s.style for s in reversed(segments) if s.text), None)
        )
        segments = Segment.adjust_line_length(segments, width, style=fill)
    return "".join(s.style.render(s.text) if s.style else s.text for s in segments)


def fold_offsets(text: str, width: int) -> list[int]:
    """Return the offsets at which *text* must be split to fit *width* columns."""
    offsets: list[int] = []
    used = 0
    spans, _ = split_graphemes(text)
    for start, _, grapheme_width in spans:
        if used + grapheme_width > width:
            offsets.append(start)
            used = 0
        used += grapheme_width
    return offsets


def wrap_ansi_line_to_rows(line: bytes, term_width: int) -> list[bytes]:
    """Split one ANSI-colored line into terminal-width display rows."""
    decoded = line.decode("utf-8", errors="replace")
    text = Text.from_ansi(decoded)
    fill = erase_fill_style(decoded)
    return [
        render_ansi_text(row, term_width, fill).encode("utf-8", errors="replace")
        for row in text.divide(fold_offsets(text.plain, term_width))
    ]


def build_margin_markers(
    hunk: Hunk,
    selected_target: LineTarget | None = None,
) -> tuple[list[bytes] | None, int | None]:
    """
    Build margin marker bytes and optional highlight index.

    Returns ``(None, None)`` when the hunk has no line notes and no
    *selected_target*.  When *selected_target* is given the markers are
    always built so the line picker can display them.
    """
    has_line_notes = any(isinstance(n.target, LineTarget) for n in hunk.notes)
    if not has_line_notes and selected_target is None:
        return None, None

    markers: list[bytes] = []
    highlight_index: int | None = None
    for i, dl in enumerate(hunk.display_lines):
        if selected_target is not None and dl.target == selected_target:
            highlight_index = i
            markers.append(MARGIN_EMPTY)
        elif dl.target and (note := hunk.get_note(dl.target)):
            markers.append(f"{note.kind.icon} ".encode())
        else:
            markers.append(MARGIN_EMPTY)
    return markers, highlight_index


def initial_line_picker_cursor(
    selectable: list[DisplayLine],
    hunk: Hunk,
    scroll_offset: int,
) -> int:
    """Return the selectable index of the first line at or after *scroll_offset*."""
    for cursor, dl in enumerate(selectable):
        idx = next((i for i, d in enumerate(hunk.display_lines) if d is dl), None)
        if idx is not None and idx >= scroll_offset:
            return cursor
    return 0


def build_display_lines(
    delta_output: bytes,
    term_width: int,
    margin_markers: list[bytes] | None = None,
    highlight_index: int | None = None,
    highlight_escape: bytes = REVERSE.encode(),
) -> list[bytes]:
    """Return physical terminal rows for rendered diff output."""
    raw_lines = delta_output.split(b"\n")

    # Delta output ends with a trailing newline and may start with a leading
    # blank line; strip both to avoid visual gaps in the chrome.
    if raw_lines and raw_lines[-1] == b"":
        raw_lines = raw_lines[:-1]
    if raw_lines and raw_lines[0] == b"":
        raw_lines = raw_lines[1:]

    wrap_width = term_width - MARGIN_WIDTH if margin_markers else term_width

    display_lines: list[bytes] = []
    for i, line in enumerate(raw_lines):
        highlighted = highlight_index is not None and i == highlight_index
        source = (
            Text.from_ansi(line.decode("utf-8", errors="replace")).plain.encode()
            if highlighted
            else line
        )
        for j, segment in enumerate(wrap_ansi_line_to_rows(source, wrap_width)):
            row = segment
            if margin_markers:
                margin = margin_markers[i] if i < len(margin_markers) else MARGIN_EMPTY
                row = (margin if j == 0 else MARGIN_EMPTY) + row
            if highlighted:
                row = highlight_escape + row + RESET.encode()
            display_lines.append(row)

    return display_lines or [b""]


def compute_diff_viewport(
    total_lines: int,
    term_height: int,
    scroll_offset: int,
) -> DiffViewport:
    """
    Compute which diff lines are visible given the terminal geometry.

    The fixed chrome occupies ``CHROME_ROWS`` rows (top bar + markers + footer).
    Scroll indicators are reserved only when actually needed.
    """
    max_avail = term_height - CHROME_ROWS

    if total_lines <= max_avail:
        scroll_offset = 0
        can_scroll_up = False
        can_scroll_down = False
        visible_count = total_lines
    else:
        max_offset = max(0, total_lines - (max_avail - SCROLL_INDICATOR_ROWS))
        scroll_offset = min(scroll_offset, max_offset)

        can_scroll_up = scroll_offset > 0
        rows_with_both = max_avail - (1 if can_scroll_up else 0) - 1
        available_rows = max(rows_with_both, MIN_VISIBLE_ROWS)
        visible_count = min(available_rows, total_lines - scroll_offset)
        can_scroll_down = scroll_offset + visible_count < total_lines
        if not can_scroll_down:
            rows_without_down = max_avail - (1 if can_scroll_up else 0)
            available_rows = max(rows_without_down, MIN_VISIBLE_ROWS)
            visible_count = min(available_rows, total_lines - scroll_offset)

    lines_above = scroll_offset
    lines_below = total_lines - scroll_offset - visible_count

    return DiffViewport(
        scroll_offset=scroll_offset,
        visible_line_count=visible_count,
        total_lines=total_lines,
        can_scroll_up=can_scroll_up,
        can_scroll_down=can_scroll_down,
        lines_above=lines_above,
        lines_below=lines_below,
    )


def chrome_line(text: str, term_width: int) -> str:
    """Wrap *text* with the chrome background, padded to *term_width*."""
    bg_text = BG_CHROME + text.replace(RESET, RESET + BG_CHROME)
    pad = max(0, term_width - visible_width(text))
    return bg_text + " " * pad + RESET


def build_progress_hunk_segment(
    current_index: int,
    hunks: list[Hunk],
) -> str:
    """Build the 'Hunk N/M' segment with a progress fill."""
    total = len(hunks)
    handled = sum(1 for h in hunks if h.is_handled)
    label = f" Hunk {current_index + 1}/{total} "
    filled = len(label) * handled // total
    filled_part = label[:filled]
    unfilled_part = label[filled:]
    return f"│{BLACK}{BG_CYAN}{filled_part}{RESET}{unfilled_part}│"


def build_top_bar(
    hunk: Hunk,
    current_index: int,
    hunks: list[Hunk],
    global_notes: list[GlobalNote],
    term_width: int | None = None,
) -> str:
    """Build the top status bar string for the current hunk."""
    counters = build_top_bar_counters(hunks, global_notes)
    progress_segment = build_progress_hunk_segment(current_index, hunks)

    bar = (
        f"{BOLD}{WHITE}{BG_BLUE} neorev {RESET}"
        f"{progress_segment}"
        f" {hunk.file_status.marker} {BOLD}{hunk.location_label}{RESET}"
        f"{counters}"
    )
    if term_width is not None:
        styled = Text.from_ansi(bar)
        if styled.cell_len > term_width:
            styled.truncate(term_width, overflow="ellipsis")
            bar = render_ansi_text(styled)
    return bar


def build_top_bar_counters(
    hunks: list[Hunk],
    global_notes: list[GlobalNote],
) -> str:
    """Build the compact note-count segment for the top bar."""
    counts: Counter[tuple[type, NoteKind]] = Counter(
        (type(note.target), note.kind) for hunk in hunks for note in hunk.notes
    )
    global_counts: Counter[NoteKind] = Counter(n.kind for n in global_notes)
    parts = [
        f"global {NoteKind.FLAG.icon} {global_counts[NoteKind.FLAG]}"
        f" {NoteKind.QUESTION.icon} {global_counts[NoteKind.QUESTION]}",
        f"hunk {NoteKind.FLAG.icon} {counts[(HunkTarget, NoteKind.FLAG)]}"
        f" {NoteKind.QUESTION.icon} {counts[(HunkTarget, NoteKind.QUESTION)]}",
        f"line {NoteKind.FLAG.icon} {counts[(LineTarget, NoteKind.FLAG)]}"
        f" {NoteKind.QUESTION.icon} {counts[(LineTarget, NoteKind.QUESTION)]}",
    ]
    return "  │ " + " │ ".join(parts)


def hunk_marker(hunk: Hunk, *, is_current: bool) -> str:
    """Return the ANSI-styled marker for a single hunk (3 visible chars)."""
    icon = "·"
    color = DIM
    status = hunk.summary_status
    if status == Status.APPROVED:
        icon, color = "✓", GREEN
    elif status == Status.FLAG:
        icon, color = "✗", RED
    elif status == Status.QUESTION:
        icon, color = "?", YELLOW
    if is_current:
        return f"{BOLD}[{color}{icon}{RESET}{BOLD}]{RESET}"
    return f" {color}{icon}{RESET} "


def build_progress_markers(
    hunks: list[Hunk],
    current_index: int,
    term_width: int,
) -> str:
    """Build the hunk progress marker line, with overflow arrows."""
    total = len(hunks)
    prefix = "  "
    prefix_width = 2
    available = term_width - prefix_width
    if available < MARKER_WIDTH:
        return ""
    max_markers = available // MARKER_WIDTH

    if max_markers >= total:
        markers = [
            hunk_marker(hunks[i], is_current=i == current_index) for i in range(total)
        ]
        return prefix + "".join(markers)

    slots = (available - ARROW_WIDTH * 2) // MARKER_WIDTH
    slots = max(slots, 1)

    half = slots // 2
    start = current_index - half
    end = start + slots

    if start < 0:
        start, end = 0, slots
    if end > total:
        end = total
        start = max(0, end - slots)

    need_left = start > 0
    need_right = end < total

    if not need_left or not need_right:
        extra = (
            available - (ARROW_WIDTH if need_left or need_right else 0)
        ) // MARKER_WIDTH
        extra = max(extra, 1)
        if extra > slots:
            slots = min(extra, total)
            half = slots // 2
            start = current_index - half
            end = start + slots
            if start < 0:
                start, end = 0, slots
            if end > total:
                end = total
                start = max(0, end - slots)
            need_left = start > 0
            need_right = end < total

    markers = [
        hunk_marker(hunks[i], is_current=i == current_index) for i in range(start, end)
    ]
    left = f"{DIM}◀ {RESET}" if need_left else ""
    right = f"{DIM} ▶{RESET}" if need_right else ""
    return prefix + left + "".join(markers) + right


def build_keyhint_footer(
    segments: list[tuple[str, str]], term_width: int, *, ellipsis: bool = False
) -> str:
    """Build a key-hints footer from *segments*, truncated to *term_width*."""
    parts: list[str] = []
    used = 0
    truncated = False
    for i, (key, label) in enumerate(segments):
        sep = "  " if i > 0 else ""
        segment = f"{sep}{DIM}{key}{RESET} {label}"
        segment_width = visible_width(segment)
        if used + segment_width > term_width:
            truncated = True
            break
        parts.append(segment)
        used += segment_width
    if ellipsis and truncated and used < term_width:
        padding = term_width - used - len(TRUNCATION_ELLIPSIS)
        if padding >= 0:
            parts.append(f"{' ' * padding}{DIM}{TRUNCATION_ELLIPSIS}{RESET}")
    return "".join(parts)


NOTE_PANEL_FOOTER_SEGMENTS = [
    ("j/k", "navigate"),
    ("e/Enter", "edit"),
    ("d", "delete"),
    ("Esc", "back"),
]

MAIN_FOOTER_SEGMENTS = [
    ("j/k", "navigate"),
    ("a/A", "approve hunk/file"),
    ("c/f", "question/flag"),
    ("gc/gf", "global"),
    ("m", "manage notes"),
    ("q", "quit & save"),
    ("?", "help"),
]


def build_note_panel_header(note_count: int, term_width: int) -> str:
    """Build the separator header line for the note panel."""
    label = f" Notes ({note_count}) " if note_count else " Notes "
    fill_width = max(0, term_width - len(label) - 1)
    return f"─{label}{'─' * fill_width}"


def ends_with_separator(s: str) -> bool:
    """Return whether *s* ends with a non-alphanumeric, non-whitespace character."""
    return bool(s) and not s[-1].isalnum() and not s[-1].isspace()


def note_preview_text(text: str) -> str:
    """Build a single-line preview from a possibly multi-line note."""
    lines = [line.strip() for line in text.splitlines()]
    lines = [line for line in lines if line]
    parts: list[str] = []
    for i, line in enumerate(lines):
        if parts and not ends_with_separator(lines[i - 1]):
            parts.append(PREVIEW_INTERPUNCT)
        elif parts:
            parts.append(" ")
        parts.append(line)
    return " ".join("".join(parts).split())


def build_note_panel_row(
    ref: ManagedNoteRef, *, selected: bool, term_width: int
) -> str:
    """Build one rendered row for a note in the panel."""
    cursor_mark = f"{BOLD}{NOTE_PANEL_CURSOR}{RESET}" if selected else " "
    kind_str = (
        f"{RED}flag{RESET}" if ref.kind is NoteKind.FLAG else f"{YELLOW}question{RESET}"
    )
    preview = note_preview_text(ref.text)
    prefix = f"{cursor_mark}[{kind_str}] {DIM}{ref.scope_label}{RESET} "
    max_preview = term_width - visible_width(prefix) - 1
    if max_preview > 0 and len(preview) > max_preview:
        preview = preview[: max_preview - 1] + TRUNCATION_ELLIPSIS
    elif max_preview <= 0:
        preview = ""
    return f"{prefix}{preview}"


def compute_note_panel_height(note_count: int, term_height: int) -> int:
    """Compute the number of terminal rows the note panel should occupy."""
    max_panel = max(NOTE_PANEL_MIN_HEIGHT, term_height // NOTE_PANEL_MAX_FRACTION)
    content_rows = max(note_count, 1)
    return min(content_rows + NOTE_PANEL_CHROME_ROWS, max_panel)


def drain_fd(fd: int) -> None:
    """Read and discard all currently available bytes from *fd*."""
    while True:
        ready, _, _ = select.select([fd], [], [], SELECT_IMMEDIATE)
        if not ready:
            break
        if not os.read(fd, DRAIN_READ_SIZE):
            break


def debounce_events(read_fd: int, timeout: float) -> None:
    """Drain *read_fd* until it stays quiet for *timeout* seconds."""
    while True:
        ready, _, _ = select.select([read_fd], [], [], timeout)
        if not ready:
            break
        drain_fd(read_fd)


def debounce_resize(wakeup_read_fd: int) -> None:
    """Wait briefly to coalesce rapid resize signals into one redraw."""
    debounce_events(wakeup_read_fd, RESIZE_DEBOUNCE_TIMEOUT)


class Terminal:
    """Terminal I/O state for the interactive TUI."""

    DEFAULT_WIDTH = 120
    DEFAULT_HEIGHT = 40
    HELP_KEY_COLUMN_WIDTH = 14
    HELP_BOX_MAX_WIDTH = 78
    CLEAR_SCREEN = f"{CSI}2J{CSI}H"
    ALT_SCREEN_ON = f"{CSI}?1049h"
    ALT_SCREEN_OFF = f"{CSI}?1049l"
    CURSOR_HIDE = f"{CSI}?25l"
    CURSOR_SHOW = f"{CSI}?25h"

    ESC_BYTE = b"\x1b"
    ARROW_UP_SEQ = b"[A"
    ARROW_DOWN_SEQ = b"[B"
    KEY_CTRL_C = "\x03"
    KEY_CTRL_D = "\x04"
    KEY_CTRL_U = "\x15"
    KEY_RESIZE = "resize"
    KEY_RELOAD = "reload"

    def __init__(self) -> None:
        """Open ``/dev/tty`` read-write and capture geometry and attributes."""
        self.fd = os.open("/dev/tty", os.O_RDWR)
        self.refresh_geometry()
        self.old_attrs: list[int | list[bytes | int]] = termios.tcgetattr(self.fd)
        self.wakeup_read_fd: int | None = None

    def __enter__(self) -> Self:
        """Return self for context-managed terminal usage."""
        return self

    def __exit__(self, *_: object) -> None:
        """Close the terminal when leaving a context manager block."""
        self.close()

    def refresh_geometry(self) -> None:
        """Re-read terminal dimensions, clamping to safe minimums."""
        try:
            ts = os.get_terminal_size(self.fd)
            self.width = max(ts.columns, MIN_TERMINAL_WIDTH)
            self.height = max(ts.lines, MIN_TERMINAL_HEIGHT)
        except OSError:
            self.width = max(
                getattr(self, "width", self.DEFAULT_WIDTH), MIN_TERMINAL_WIDTH
            )
            self.height = max(
                getattr(self, "height", self.DEFAULT_HEIGHT), MIN_TERMINAL_HEIGHT
            )

    def apply_resize(self, delta_cache: dict[int, DeltaStream]) -> None:
        """Refresh geometry and clear cache if width changed."""
        old_width = self.width
        self.refresh_geometry()
        if self.width != old_width:
            for stream in delta_cache.values():
                stream.kill()
            delta_cache.clear()

    def close(self) -> None:
        """Restore terminal attributes and close the file descriptor."""
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_attrs)
        os.close(self.fd)

    def write(self, data: bytes | str) -> None:
        """Write raw bytes or a string to the terminal display."""
        if isinstance(data, str):
            data = data.encode()
        os.write(self.fd, data)

    def read_key(
        self,
        wakeup_read_fd: int | None = None,
        watch_read_fd: int | None = None,
    ) -> str:
        """Read one keypress, with optional wakeup and repo-watch pipes."""
        extra_fds = [fd for fd in (wakeup_read_fd, watch_read_fd) if fd is not None]
        if extra_fds:
            readable, _, _ = select.select([self.fd, *extra_fds], [], [])
            if watch_read_fd is not None and watch_read_fd in readable:
                drain_fd(watch_read_fd)
                debounce_events(watch_read_fd, WATCH_DEBOUNCE_TIMEOUT)
                return self.KEY_RELOAD
            if wakeup_read_fd is not None and wakeup_read_fd in readable:
                drain_fd(wakeup_read_fd)
                debounce_resize(wakeup_read_fd)
                return self.KEY_RESIZE
        ch = os.read(self.fd, 1)
        if ch == self.ESC_BYTE:
            return self.read_escape_sequence()
        return ch.decode("utf-8", errors="replace")

    def read_escape_sequence(self) -> str:
        """Resolve an escape byte into an arrow key, or 'esc' on timeout."""
        ready, _, _ = select.select([self.fd], [], [], ESC_SEQUENCE_TIMEOUT)
        if not ready:
            return "esc"
        seq = os.read(self.fd, 2)
        if seq == self.ARROW_UP_SEQ:
            return "up"
        if seq == self.ARROW_DOWN_SEQ:
            return "down"
        return "esc"

    def edit_comment(
        self,
        existing: str,
        location: str,
        context_lines: list[str] | None = None,
    ) -> str:
        """Edit a review comment using ``$EDITOR`` or an inline TTY prompt."""
        editor = os.environ.get("EDITOR", "")
        if editor:
            return self.edit_comment_in_editor(
                existing, location, editor, context_lines
            )
        return self.prompt_inline_comment(existing, location)

    def edit_comment_in_editor(
        self,
        existing: str,
        location: str,
        editor: str,
        context_lines: list[str] | None = None,
    ) -> str:
        """Open *editor* with a temporary file pre-filled with *existing*."""
        with tempfile.TemporaryDirectory(prefix="review-") as tmpdir:
            tmppath = str(Path(tmpdir) / "comment.cfg")
            with open(tmppath, "w") as tmp:
                jump_line = write_comment_template(
                    tmp, location, existing, context_lines
                )
            with duplicated_fd(self.fd) as dup_fd:
                subprocess.run(
                    [editor, f"{tmppath}:{jump_line}"],
                    check=True,
                    stdin=dup_fd,
                    stdout=dup_fd,
                    stderr=dup_fd,
                )
            return read_comment_file(tmppath)

    def prompt_inline_comment(self, existing: str, location: str) -> str:
        """Prompt for a single-line comment directly on the TTY."""
        prompt = f"\r\n  Comment for {location}"
        if existing:
            prompt += f" [{existing}]"
        prompt += ": "
        self.write(prompt)

        old = termios.tcgetattr(self.fd)
        cooked = termios.tcgetattr(self.fd)
        cooked[3] |= termios.ECHO | termios.ICANON
        termios.tcsetattr(self.fd, termios.TCSADRAIN, cooked)
        dup_fd = os.dup(self.fd)
        try:
            with os.fdopen(dup_fd, "r") as f:
                line = f.readline().strip()
        finally:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, old)
        return line or existing

    def edit_text_outside_tui(
        self,
        existing_text: str,
        prompt_label: str,
        context_lines: list[str] | None = None,
    ) -> str:
        """Temporarily suspend the TUI, edit text, and restore raw mode."""
        self.write(f"{self.CURSOR_SHOW}{self.ALT_SCREEN_OFF}")
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_attrs)
        comment = self.edit_comment(existing_text, prompt_label, context_lines)
        self.refresh_geometry()
        self.write(f"{self.ALT_SCREEN_ON}{self.CURSOR_HIDE}")
        tty.setraw(self.fd)
        return comment

    def render_review_screen(  # noqa: PLR0913
        self,
        hunks: list[Hunk],
        current_index: int,
        delta_output: bytes,
        global_notes: list[GlobalNote],
        scroll_offset: int = 0,
        *,
        streaming: bool = False,
    ) -> int:
        """Render the full review screen and return the clamped scroll offset."""
        hunk = hunks[current_index]
        margins, _ = build_margin_markers(hunk)
        diff_lines = build_display_lines(delta_output, self.width, margins)
        viewport = compute_diff_viewport(len(diff_lines), self.height, scroll_offset)

        self.write(self.CLEAR_SCREEN)

        top_bar = build_top_bar(hunk, current_index, hunks, global_notes, self.width)
        self.write(chrome_line(top_bar, self.width) + "\r\n")

        markers = build_progress_markers(hunks, current_index, self.width)
        self.write(chrome_line(markers, self.width) + "\r\n")

        self.render_diff_body(diff_lines, viewport)
        self.render_footer(viewport, streaming=streaming)

        return viewport.scroll_offset

    def render_diff_body(
        self,
        diff_lines: list[bytes],
        viewport: DiffViewport,
    ) -> None:
        """Render the visible diff lines with scroll indicators."""
        if viewport.can_scroll_up:
            self.write(
                f"  {BOLD}{WHITE}▲ Ctrl-U to scroll up "
                f"({viewport.lines_above} lines above){RESET}\r\n",
            )

        start = viewport.scroll_offset
        end = start + viewport.visible_line_count
        for line in diff_lines[start:end]:
            self.write(line)
            self.write(b"\r\n")

    def render_footer(
        self,
        viewport: DiffViewport,
        footer_text: str | None = None,
        *,
        streaming: bool = False,
    ) -> None:
        """Render the scroll-down indicator and bottom key hints."""
        if viewport.can_scroll_down:
            self.write(f"{CSI}{self.height - 1};1H")
            suffix = "" if streaming else f" ({viewport.lines_below} lines below)"
            self.write(f"  {BOLD}{WHITE}▼ Ctrl-D to scroll down{suffix}{RESET}")

        self.write(f"{CSI}{self.height};1H")
        if footer_text is None:
            footer_text = build_keyhint_footer(
                MAIN_FOOTER_SEGMENTS, self.width, ellipsis=True
            )
        self.write(chrome_line(footer_text, self.width))

    def render_help_screen(self) -> None:
        """Display the keyboard shortcuts help overlay."""
        self.write(self.CLEAR_SCREEN)
        bindings = [
            ("j / ↓", "Next hunk"),
            ("k / ↑", "Previous hunk"),
            ("Ctrl-D", "Scroll diff down (half page)"),
            ("Ctrl-U", "Scroll diff up (half page)"),
            ("a", "Approve hunk (no comment needed)"),
            ("A", "Approve all hunks in current file"),
            ("c", "Add question (hunk or line target, opens $EDITOR)"),
            ("f", "Add flag / request change (hunk or line target, opens $EDITOR)"),
            (
                "gc",
                "Add global question (not tied to a specific hunk, opens $EDITOR)",
            ),
            (
                "gf",
                "Add global flag / request change (not tied to a specific hunk,"
                " opens $EDITOR)",
            ),
            ("m", "Manage notes (edit / delete)"),
            ("q / Ctrl-C", "Quit and write output to file"),
            ("?", "Show help"),
        ]
        col = self.HELP_KEY_COLUMN_WIDTH
        max_w = self.HELP_BOX_MAX_WIDTH
        right_margin = 1
        desc_max = max_w - 2 - col - right_margin  # 2-char indent + key column + margin
        binding_rows: list[str] = []
        for key, desc in bindings:
            desc_lines = textwrap.wrap(desc, desc_max)
            pad = " " * (col - len(key))
            binding_rows.append(f"  {BOLD}{key}{RESET}{pad}{desc_lines[0]}")
            cont_pad = " " * (2 + col)
            binding_rows.extend(f"{cont_pad}{cont}" for cont in desc_lines[1:])
        rows = [
            f"{BOLD}  neorev — Keyboard Shortcuts{RESET}",
            "",
            *binding_rows,
            "",
            f"  Set {BOLD}$EDITOR{RESET} (e.g. hx, nvim) for multi-line",
            "  comments. Without it, single-line prompt is used.",
            "",
            f"  {DIM}Press any key to return.{RESET}",
        ]
        width = max(visible_width(row) for row in rows) + right_margin
        border = "─" * width
        self.write(chrome_line(f"┌{border}┐", self.width) + "\r\n")
        self.write(chrome_line(f"├{border}┤", self.width) + "\r\n")
        self.write_box_rows(width, rows)
        self.write(chrome_line(f"└{border}┘", self.width) + "\r\n")

    def write_box_rows(self, width: int, rows: list[str]) -> None:
        """Write a sequence of bordered rows, treating empty strings as blanks."""
        for row in rows:
            self.write_box_row(width, row)

    def write_box_row(self, width: int, text: str = "") -> None:
        """Write one bordered row padded to *width*."""
        pad = width - visible_width(text)
        self.write(chrome_line(f"│{text}{' ' * pad}│", self.width) + "\r\n")

    def handle_manage_notes(self, state: ReviewState) -> None:
        """Interactive panel to manage all notes with cursor navigation."""
        panel = NotePanelState()
        hunk = state.hunks[state.current_index]
        delta_output = render_through_delta(hunk.raw, width=self.width)
        while True:
            refs = state.managed_note_refs()
            if refs:
                panel.cursor = min(panel.cursor, len(refs) - 1)
            else:
                panel.cursor = 0
            self.render_note_panel(state, refs, panel, delta_output)
            key = self.read_key(wakeup_read_fd=self.wakeup_read_fd)

            if key == self.KEY_RESIZE:
                self.refresh_geometry()
                if delta_output:
                    hunk = state.hunks[state.current_index]
                    delta_output = render_through_delta(hunk.raw, width=self.width)
                continue

            if key in ("q", "esc", self.KEY_CTRL_C):
                break

            if key in ("j", "down") and refs:
                panel.cursor = min(panel.cursor + 1, len(refs) - 1)
            elif key in ("k", "up") and refs:
                panel.cursor = max(panel.cursor - 1, 0)
            elif key in ("e", "\r") and refs:
                self.modify_managed_note(state, refs[panel.cursor], edit=True)
                tty.setraw(self.fd)
                break
            elif key == "d" and refs:
                self.modify_managed_note(state, refs[panel.cursor], edit=False)
                break

    def render_note_panel(
        self,
        state: ReviewState,
        refs: list[ManagedNoteRef],
        panel: NotePanelState,
        delta_output: bytes,
    ) -> None:
        """Render the diff with a note management panel at the bottom."""
        panel_height = compute_note_panel_height(len(refs), self.height)
        diff_height = self.height - panel_height

        self.write(self.CLEAR_SCREEN)

        if delta_output and diff_height > CHROME_ROWS:
            self.render_note_panel_diff(state, delta_output, diff_height)

        panel_top = self.height - panel_height + 1
        self.write(f"{CSI}{panel_top};1H")
        header = build_note_panel_header(len(refs), self.width)
        self.write(chrome_line(header, self.width) + "\r\n")

        content_rows = panel_height - NOTE_PANEL_CHROME_ROWS
        self.render_note_panel_rows(refs, panel, content_rows)

        self.write(f"{CSI}{self.height};1H")
        footer = build_keyhint_footer(NOTE_PANEL_FOOTER_SEGMENTS, self.width)
        self.write(chrome_line(footer, self.width))

    def render_note_panel_diff(
        self,
        state: ReviewState,
        delta_output: bytes,
        diff_height: int,
    ) -> None:
        """Render the reduced-height diff above the note panel."""
        hunk = state.hunks[state.current_index]
        margins, _ = build_margin_markers(hunk)
        diff_lines = build_display_lines(delta_output, self.width, margins)
        top_bar = build_top_bar(
            hunk,
            state.current_index,
            state.hunks,
            state.global_notes,
            self.width,
        )
        self.write(chrome_line(top_bar, self.width) + "\r\n")
        markers = build_progress_markers(state.hunks, state.current_index, self.width)
        self.write(chrome_line(markers, self.width) + "\r\n")
        max_lines = diff_height - NOTE_PANEL_DIFF_CHROME_ROWS
        start = min(state.scroll_offset, max(0, len(diff_lines) - max_lines))
        end = start + max_lines
        for line in diff_lines[start:end]:
            self.write(line)
            self.write(b"\r\n")

    def render_note_panel_rows(
        self,
        refs: list[ManagedNoteRef],
        panel: NotePanelState,
        content_rows: int,
    ) -> None:
        """Render the scrollable note list inside the panel."""
        empty_chrome = chrome_line("", self.width)
        if not refs:
            self.write(chrome_line(f"  {DIM}No notes yet.{RESET}", self.width) + "\r\n")
            for _ in range(content_rows - 1):
                self.write(empty_chrome + "\r\n")
            return

        if panel.cursor < panel.scroll_offset:
            panel.scroll_offset = panel.cursor
        elif panel.cursor >= panel.scroll_offset + content_rows:
            panel.scroll_offset = panel.cursor - content_rows + 1

        for i in range(content_rows):
            idx = panel.scroll_offset + i
            if idx >= len(refs):
                self.write(empty_chrome + "\r\n")
                continue
            row = build_note_panel_row(
                refs[idx],
                selected=idx == panel.cursor,
                term_width=self.width,
            )
            self.write(chrome_line(row, self.width) + "\r\n")

    def modify_managed_note(
        self,
        state: ReviewState,
        ref: ManagedNoteRef,
        *,
        edit: bool,
    ) -> None:
        """Edit or delete the note identified by *ref*."""
        found = state.find_note_by_ref(ref)
        if found is None:
            return

        if isinstance(found, GlobalNote):
            if edit:
                new_text = self.edit_text_outside_tui(
                    found.text, ref.kind.global_editor_label
                )
                if new_text:
                    found.text = new_text
                    return
            state.global_notes.remove(found)
            return

        hunk, note = found
        if edit:
            if isinstance(note.target, LineTarget):
                ctx = hunk.build_line_context(note.target)
            else:
                ctx = hunk.build_hunk_context(state.scroll_offset)
            new_text = self.edit_text_outside_tui(note.text, ref.kind.editor_label, ctx)
            if new_text:
                note.text = new_text
                return
        hunk.notes.remove(note)

    def handle_hunk_comment(self, state: ReviewState, key: str) -> None:
        """Handle ``c`` (question) or ``f`` (flag) with target selection."""
        hunk = state.hunks[state.current_index]
        kind = NoteKind.FLAG if key == "f" else NoteKind.QUESTION

        target: NoteTarget | None = (
            self.pick_line_target(state, kind)
            if any(dl.target is not None for dl in hunk.display_lines)
            else HunkTarget()
        )

        if target is None:
            return

        existing = hunk.get_note(target)
        existing_text = existing.text if existing else ""

        if isinstance(target, LineTarget):
            ctx = hunk.build_line_context(target)
        else:
            ctx = hunk.build_hunk_context(state.scroll_offset)
        comment = self.edit_text_outside_tui(
            existing_text,
            f"{hunk.short_location} @ {target} [{kind.editor_label}]",
            ctx,
        )

        if comment:
            hunk.upsert_note(kind, target, comment)
            hunk.approved = False
            if isinstance(target, HunkTarget):
                state.current_index = state.find_next_unhandled()
        elif existing:
            hunk.remove_note(target)

    def pick_line_target(self, state: ReviewState, kind: NoteKind) -> NoteTarget | None:
        """Display a full-screen delta line picker and return the chosen target."""
        hunk = state.hunks[state.current_index]
        selectable = [dl for dl in hunk.display_lines if dl.target is not None]
        if not selectable:
            return None

        cursor = initial_line_picker_cursor(selectable, hunk, state.scroll_offset)
        scroll = state.scroll_offset
        highlight = (
            BG_YELLOW_BLACK.encode() if kind is NoteKind.FLAG else REVERSE.encode()
        )
        delta_output = render_through_delta(
            hunk.raw,
            width=self.width,
        )
        while True:
            scroll = self.render_line_picker(
                state,
                selectable,
                cursor,
                delta_output,
                scroll,
                highlight_escape=highlight,
            )
            key = self.read_key(wakeup_read_fd=self.wakeup_read_fd)
            if key == self.KEY_RESIZE:
                self.refresh_geometry()
                delta_output = render_through_delta(
                    hunk.raw,
                    width=self.width,
                )
                continue
            if key in ("q", "esc", self.KEY_CTRL_C):
                return None
            if key == "h":
                return HunkTarget()
            if key in ("j", "down"):
                cursor = min(cursor + 1, len(selectable) - 1)
            elif key in ("k", "up"):
                cursor = max(cursor - 1, 0)
            elif key == LINE_PICKER_SELECT_KEY:
                return selectable[cursor].target

    def render_line_picker(  # noqa: PLR0913
        self,
        state: ReviewState,
        selectable: list[DisplayLine],
        cursor: int,
        delta_output: bytes,
        scroll_offset: int,
        *,
        highlight_escape: bytes = REVERSE.encode(),
    ) -> int:
        """Render full-screen line picker with delta formatting."""
        hunk = state.hunks[state.current_index]
        selected_target = selectable[cursor].target
        margin_markers, highlight_idx = build_margin_markers(hunk, selected_target)
        diff_lines = build_display_lines(
            delta_output,
            self.width,
            margin_markers,
            highlight_index=highlight_idx,
            highlight_escape=highlight_escape,
        )

        # Ensure cursor line is visible
        cursor_idx = next(
            (i for i, dl in enumerate(hunk.display_lines) if dl is selectable[cursor]),
            None,
        )
        if cursor_idx is not None:
            visible = self.height - CHROME_ROWS - SCROLL_INDICATOR_ROWS
            if cursor_idx < scroll_offset:
                scroll_offset = cursor_idx
            elif cursor_idx >= scroll_offset + visible:
                scroll_offset = cursor_idx - visible + 1

        viewport = compute_diff_viewport(
            len(diff_lines),
            self.height,
            scroll_offset,
        )

        self.write(self.CLEAR_SCREEN)
        top_bar = build_top_bar(
            hunk,
            state.current_index,
            state.hunks,
            state.global_notes,
            self.width,
        )
        self.write(chrome_line(top_bar, self.width) + "\r\n")
        markers = build_progress_markers(state.hunks, state.current_index, self.width)
        self.write(chrome_line(markers, self.width) + "\r\n")
        self.render_diff_body(diff_lines, viewport)
        picker_footer = build_keyhint_footer(LINE_PICKER_FOOTER_SEGMENTS, self.width)
        self.render_footer(viewport, picker_footer)
        return viewport.scroll_offset

    def handle_global_note(self, state: ReviewState, key: str) -> None:
        """Handle ``gc`` (global question) or ``gf`` (global flag)."""
        kind = NoteKind.FLAG if key == "f" else NoteKind.QUESTION
        text = self.edit_text_outside_tui("", kind.global_editor_label)
        if text:
            state.global_notes.append(GlobalNote(kind=kind, text=text))

    def handle_scroll(
        self,
        key: str,
        state: ReviewState,
        redraw: Callable[[], None],
    ) -> bool:
        """Handle scroll keys (Ctrl-D/Ctrl-U), returning True if handled."""
        half = max(1, (self.height - CHROME_ROWS - SCROLL_INDICATOR_ROWS) // 2)
        if key == self.KEY_CTRL_D:
            state.scroll_offset += half
        elif key == self.KEY_CTRL_U:
            state.scroll_offset = max(0, state.scroll_offset - half)
        else:
            return False
        redraw()
        return True

    def dispatch_key(
        self,
        key: str,
        state: ReviewState,
        redraw: Callable[[], None],
    ) -> bool:
        """Handle a single keypress, returning True if a full redraw is needed."""
        if self.handle_scroll(key, state, redraw):
            return False

        if state.navigate(key):
            state.scroll_offset = 0
            return True

        if key == "a":
            state.approve()
        elif key == "A":
            state.approve_file()
        elif key in ("c", "f"):
            self.handle_hunk_comment(state, key)
        elif key == "g":
            key2 = self.read_key()
            if key2 not in ("c", "f"):
                return False
            self.handle_global_note(state, key2)
        elif key == "m":
            self.handle_manage_notes(state)
        elif key == "?":
            self.render_help_screen()
            self.read_key()
        else:
            return False
        return True

    def run_review_loop(
        self,
        state: ReviewState,
        delta_cache: dict[int, DeltaStream],
        watch_read_fd: int | None = None,
    ) -> LoopResult:
        """Run the interactive key-handling loop until quit or repo change."""
        with nonblocking_pipe() as (wakeup_r, wakeup_w):

            def get_stream(index: int) -> DeltaStream:
                """Return the cached delta stream for hunk at *index*."""
                if index not in delta_cache:
                    delta_cache[index] = DeltaStream(
                        state.hunks[index].raw,
                        width=self.width,
                    )
                return delta_cache[index]

            def redraw() -> None:
                """Redraw the review screen."""
                viewport_lines = self.height - CHROME_ROWS
                needed = (
                    state.scroll_offset + viewport_lines + DELTA_VIEWPORT_LINE_BUFFER
                )
                stream = get_stream(state.current_index)
                delta_output = stream.get_output(needed)
                state.scroll_offset = self.render_review_screen(
                    state.hunks,
                    state.current_index,
                    delta_output,
                    state.global_notes,
                    state.scroll_offset,
                    streaming=not stream.exhausted,
                )

            prev_wakeup_fd = signal.set_wakeup_fd(wakeup_w, warn_on_full_buffer=False)
            prev_handler = signal.getsignal(signal.SIGWINCH)
            signal.signal(signal.SIGWINCH, lambda *_: None)
            self.wakeup_read_fd = wakeup_r
            try:
                tty.setraw(self.fd)
                redraw()

                while True:
                    key = self.read_key(
                        wakeup_read_fd=wakeup_r, watch_read_fd=watch_read_fd
                    )

                    if key == self.KEY_RESIZE:
                        self.apply_resize(delta_cache)
                        redraw()
                        continue

                    if key == self.KEY_RELOAD:
                        return LoopResult.RELOAD

                    if key in ("q", self.KEY_CTRL_C):
                        return LoopResult.QUIT

                    handled = self.dispatch_key(key, state, redraw)
                    if handled:
                        redraw()
            finally:
                for stream in delta_cache.values():
                    stream.kill()
                self.wakeup_read_fd = None
                signal.signal(signal.SIGWINCH, prev_handler)
                signal.set_wakeup_fd(prev_wakeup_fd)

    def render_wait_screen(self) -> None:
        """Render the placeholder shown while the watched diff is empty."""
        self.write(self.CLEAR_SCREEN)
        row = max(1, self.height // 2)
        col = max(1, (self.width - visible_width(EMPTY_DIFF_WAIT_MESSAGE)) // 2 + 1)
        self.write(f"{CSI}{row};{col}H{DIM}{EMPTY_DIFF_WAIT_MESSAGE}{RESET}")
        self.write(f"{CSI}{self.height};1H")
        footer = build_keyhint_footer(WATCH_WAIT_FOOTER_SEGMENTS, self.width)
        self.write(chrome_line(footer, self.width))

    def run_wait_screen(self, watch_read_fd: int) -> LoopResult:
        """Wait on the empty-diff placeholder until a repo change or quit."""
        with nonblocking_pipe() as (wakeup_r, wakeup_w):
            prev_wakeup_fd = signal.set_wakeup_fd(wakeup_w, warn_on_full_buffer=False)
            prev_handler = signal.getsignal(signal.SIGWINCH)
            signal.signal(signal.SIGWINCH, lambda *_: None)
            self.wakeup_read_fd = wakeup_r
            try:
                tty.setraw(self.fd)
                self.render_wait_screen()
                while True:
                    key = self.read_key(
                        wakeup_read_fd=wakeup_r, watch_read_fd=watch_read_fd
                    )
                    if key == self.KEY_RELOAD:
                        return LoopResult.RELOAD
                    if key == self.KEY_RESIZE:
                        self.refresh_geometry()
                        self.render_wait_screen()
                    elif key in ("q", self.KEY_CTRL_C):
                        return LoopResult.QUIT
            finally:
                self.wakeup_read_fd = None
                signal.signal(signal.SIGWINCH, prev_handler)
                signal.set_wakeup_fd(prev_wakeup_fd)


class RepoWatcher:
    """Monitors repository paths via ``inotifywait`` and signals on a pipe."""

    def __init__(self, paths: list[str]) -> None:
        """Spawn ``inotifywait`` on *paths* and a thread forwarding events."""
        self.read_fd, self.write_fd = os.pipe()
        os.set_blocking(self.read_fd, False)
        self.process: subprocess.Popen[bytes] | None = None
        if paths:
            self.process = subprocess.Popen(
                [
                    "inotifywait",
                    "-m",
                    "-q",
                    "-e",
                    "close_write,create,delete,move",
                    "--",
                    *paths,
                ],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
            )
        self.reader: threading.Thread = threading.Thread(target=self.pump, daemon=True)
        self.reader.start()

    def pump(self) -> None:
        """Forward every ``inotifywait`` event line as one wakeup byte."""
        if self.process is None or self.process.stdout is None:
            return
        for _ in self.process.stdout:
            with suppress(OSError):
                os.write(self.write_fd, b"\x01")

    def close(self) -> None:
        """Terminate ``inotifywait`` and release the pipe and thread."""
        if self.process is not None:
            if self.process.poll() is None:
                self.process.terminate()
                self.process.wait()
            if self.process.stdout is not None:
                self.process.stdout.close()
        self.reader.join()
        os.close(self.read_fd)
        os.close(self.write_fd)


def build_arg_parser() -> argparse.ArgumentParser:
    """Build and return the argument parser for neorev."""
    parser = argparse.ArgumentParser(
        prog="neorev",
        description=__doc__,
        epilog="When no diff is piped and no revision is given, defaults to "
        f"'jj show {JJ_DEFAULT_REV}' in the current jujutsu repository.",
    )
    parser.add_argument(
        "-c",
        "--clear",
        action="store_true",
        help="Discard previous review and start fresh",
    )
    parser.add_argument(
        "-j",
        "--jj",
        dest="source",
        nargs="?",
        type=JjSource,
        const=JjSource(None),
        default=None,
        metavar="REV",
        help="Run 'jj show [REV]' and use its output as the diff",
    )
    parser.add_argument(
        "-o",
        "--output",
        default=None,
        help="Output file for the review (created or updated); "
        "defaults to $XDG_STATE_HOME/agents/reviews/<project>/<rev>-neorev.md",
    )
    parser.add_argument(
        "-x",
        "--clip",
        action="store_true",
        help="Copy @output_file to clipboard (via xclip) on exit",
    )
    parser.add_argument(
        "-w",
        "--watch",
        action="store_true",
        help="Reload the review when the repository changes "
        "(requires inotifywait and a -j or auto-detected jj source)",
    )
    return parser


@dataclass
class JjMetadata:
    """Project metadata extracted from jujutsu for default output naming."""

    dirname: str
    rev: str | None = None


def project_name(path: Path) -> str:
    """Derive a project name from the last components of *path*."""
    parts = [p for p in path.parts if p != os.sep]
    tail = parts[-PROJECT_NAME_COMPONENTS:]
    return PROJECT_NAME_SEPARATOR.join(p.lower() for p in tail)


def run_jj(command: list[str]) -> str:
    """Run a jujutsu command and return stripped stdout."""
    result = subprocess.run(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        check=True,
    )
    return result.stdout.strip()


def jj_root() -> str | None:
    """Return the jujutsu repository root, or None when not inside a jj repo."""
    try:
        return run_jj(["jj", "root", "--ignore-working-copy"])
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None


def jj_workspace_roots() -> list[Path]:
    """Return the root directory of every workspace of the current jj repo."""
    output = run_jj(
        [
            "jj",
            "workspace",
            "list",
            "--ignore-working-copy",
            "-T",
            'root ++ "\\n"',
        ]
    )
    return [Path(line) for line in output.splitlines()]


def shared_workspace_root(cwd: Path, ws_roots: list[Path]) -> Path:
    """Return the directory shared by a repo's workspace roots, or *cwd*'s own root."""
    shared = Path(os.path.commonprefix([str(root) for root in ws_roots]).rstrip(os.sep))
    # a prefix cutting mid-component is not a real directory; back up to its parent
    if not shared.is_dir():
        shared = shared.parent
    current = max(
        (root for root in ws_roots if cwd.is_relative_to(root)),
        key=lambda root: len(root.parts),
        default=cwd,
    )
    if len(current.parts) - len(shared.parts) >= WORKSPACE_SHARE_MAX_DEPTH_DELTA:
        return current
    return shared


def jj_metadata(rev: str | None = None) -> JjMetadata:
    """Return project metadata from the current jj repo, or a name-only fallback."""
    cwd = Path.cwd()
    try:
        change_id = run_jj(
            [
                "jj",
                "log",
                "--no-graph",
                "--ignore-working-copy",
                "-r",
                rev if rev is not None else JJ_DEFAULT_REV,
                "-T",
                f'change_id.short({JJ_REV_LENGTH}) ++ "\\n"',
            ]
        )
        ws_roots = jj_workspace_roots()
    except (FileNotFoundError, subprocess.CalledProcessError):
        return JjMetadata(dirname=project_name(cwd))
    return JjMetadata(
        dirname=project_name(shared_workspace_root(cwd, ws_roots)),
        rev=change_id,
    )


def compact_path(path: str) -> str:
    """Replace the user's home directory prefix with ``~``."""
    home = str(Path.home())
    if path.startswith(home + os.sep) or path == home:
        return "~" + path[len(home) :]
    return path


def default_output_path(rev: str | None = None) -> str:
    """Build the default output path under the XDG state directory."""
    xdg_state = os.environ.get(
        "XDG_STATE_HOME",
        str(Path.home() / XDG_STATE_HOME_DEFAULT),
    )
    meta = jj_metadata(rev)
    state_dir = Path(xdg_state) / REVIEWS_STATE_DIR / meta.dirname

    parts = [DEFAULT_OUTPUT_STEM]
    if meta.rev is not None:
        parts.insert(0, meta.rev)
    filename = DEFAULT_OUTPUT_SEPARATOR.join(parts) + DEFAULT_OUTPUT_EXT
    return str(state_dir / filename)


def resolve_args(args: argparse.Namespace) -> None:
    """Fill in *args.output* with the default path when not provided."""
    if args.output is not None:
        return
    rev = args.source.rev if args.source is not None else None
    args.output = default_output_path(rev)


def fetch_diff_from_jj(command: list[str]) -> str:
    """Run a jujutsu command and return its stdout, exiting on failure."""
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=True)
    except FileNotFoundError:
        sys.stderr.write(f"Error: '{command[0]}' not found.\n")
        exit(os.EX_UNAVAILABLE)
    except subprocess.CalledProcessError as exc:
        sys.stderr.write(exc.stderr or f"Error: {command} failed.\n")
        exit(os.EX_DATAERR)

    if not result.stdout.strip():
        sys.stderr.write("Empty diff.\n")
        exit(os.EX_DATAERR)

    return result.stdout


def read_diff_from_stdin() -> str:
    """Read diff text from stdin, raising *NoDiffOnStdinError* when stdin is a TTY."""
    if sys.stdin.isatty():
        raise NoDiffOnStdinError

    diff_text = sys.stdin.read()
    if not diff_text.strip():
        sys.stderr.write("Empty diff.\n")
        exit(os.EX_DATAERR)

    return diff_text


def parse_diff_or_exit(diff_text: str) -> list[Hunk]:
    """Parse *diff_text* into hunks, exiting if none are found."""
    hunks = parse_diff(diff_text)
    if not hunks:
        sys.stderr.write("No hunks found in diff.\n")
        exit(os.EX_DATAERR)
    return hunks


def load_or_resume_review(
    hunks: list[Hunk],
    output_path: str,
    *,
    quiet: bool = False,
) -> list[GlobalNote]:
    """
    Load a previous review from *output_path* if it exists.

    Applies matching annotations and approved-hunk hashes to *hunks*
    in place and returns the list of global notes. When *quiet* is set,
    suppresses the progress messages written to stderr.
    """
    previous_annotations, previous_global_notes, hashes_encoded = load_previous_review(
        output_path,
    )
    if (
        not previous_annotations
        and not previous_global_notes
        and hashes_encoded is None
    ):
        return []

    result = apply_previous_review(hunks, previous_annotations)

    approved_from_hashes = 0
    if hashes_encoded is not None:
        approved_set = decode_approved_hashes(hashes_encoded)
        for hunk in hunks:
            if hunk_identity_hash(hunk) in approved_set and not hunk.notes:
                hunk.approved = True
                approved_from_hashes += 1

    if quiet:
        return previous_global_notes

    display_path = compact_path(output_path)
    sys.stderr.write(
        f"Loaded {result.matched} hunk annotation(s), "
        f"{approved_from_hashes} approved hunk(s), and "
        f"{len(previous_global_notes)} global note(s) from {display_path}\n",
    )
    if result.stale_unmatched:
        sys.stderr.write(
            f"  ({result.stale_unmatched} previous annotation(s)"
            " no longer match any hunk)\n",
        )
    if result.stale_anchor:
        sys.stderr.write(
            f"  ({result.stale_anchor} previous annotation(s)"
            " were dropped because the hunk body changed)\n",
        )
    if result.stale_missing_target:
        sys.stderr.write(
            f"  ({result.stale_missing_target} previous annotation(s)"
            " target a line that no longer exists)\n",
        )
    return previous_global_notes


def review_has_content(hunks: list[Hunk], global_notes: list[GlobalNote]) -> bool:
    """Return True when the review contains any user action (approval or note)."""
    return (
        any(h.approved for h in hunks)
        or any(h.notes for h in hunks)
        or bool(global_notes)
    )


def review_is_all_clear(hunks: list[Hunk], global_notes: list[GlobalNote]) -> bool:
    """Return True when every hunk is approved and there are no global notes."""
    return all(h.approved for h in hunks) and not global_notes


def write_review_output(
    output_path: str,
    hunks: list[Hunk],
    global_notes: list[GlobalNote],
    diff_source: str | None = None,
    *,
    quiet: bool = False,
) -> None:
    """Write the final review output to *output_path*."""
    review_output = format_output(hunks, global_notes, diff_source)
    output = Path(output_path)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(review_output)
    if not quiet:
        sys.stderr.write(f"Review written to {compact_path(output_path)}\n")


def copy_output_reference_to_clipboard(output_path: str) -> None:
    """Copy ``@output_path`` to the system clipboard via ``xclip``."""
    clip_text = f"@{compact_path(output_path)}"
    try:
        subprocess.run(
            ["xclip", "-selection", "clipboard"],
            input=clip_text.encode(),
            check=True,
            timeout=3,
        )
        sys.stderr.write(f"Copied '{clip_text}' to clipboard\n")
    except FileNotFoundError:
        sys.stderr.write("xclip not found — install it to use --clip\n")
    except (subprocess.TimeoutExpired, subprocess.CalledProcessError) as exc:
        sys.stderr.write(f"Clipboard copy failed: {exc}\n")


def jj_diff_command(rev: str | None) -> list[str]:
    """Return the command to show the jj diff for *rev*, or the working copy."""
    # No --ignore-working-copy here (unlike the metadata queries): snapshotting
    # imports pending edits into @ so the diff reflects the current files.
    cmd = ["jj", "show"]
    if rev is not None:
        cmd.append(rev)
    return cmd


def run_jj_diff(source: JjSource) -> tuple[str, str]:
    """Run the diff command for *source* and return ``(diff text, source label)``."""
    cmd = jj_diff_command(source.rev)
    return fetch_diff_from_jj(cmd), " ".join(cmd)


def ensure_jj_or_exit(parser: argparse.ArgumentParser) -> None:
    """Exit with a usage error when the working directory is not a jj repository."""
    if jj_root() is None:
        parser.print_usage(sys.stderr)
        sys.stderr.write(
            "\nError: no diff on stdin and not inside a jujutsu repository."
            " Pipe a diff or pass a revision with -j.\n",
        )
        exit(os.EX_USAGE)


def jj_op_heads_dir(root: str) -> Path:
    """Return the jj operation-heads directory, following a workspace repo pointer."""
    repo = Path(root) / ".jj" / "repo"
    # In a non-default workspace, .jj/repo is a file holding the path to the
    # default workspace's shared repo directory rather than the directory itself.
    if repo.is_file():
        repo = (repo.parent / repo.read_text().strip()).resolve()
    return repo / JJ_OP_HEADS_REL


def watch_paths(root: str) -> list[str]:
    """Return the jj operation-heads path to watch under *root*, if it exists."""
    op_heads = jj_op_heads_dir(root)
    return [str(op_heads)] if op_heads.exists() else []


def restart_watcher(old: RepoWatcher | None) -> RepoWatcher:
    """Close *old* (if any) and start a fresh watcher with current paths."""
    if old is not None:
        old.close()
    root = jj_root()
    paths = watch_paths(root) if root is not None else []
    return RepoWatcher(paths)


def fetch_watch_diff(source: JjSource) -> tuple[str, str]:
    """Fetch the diff for *source*, returning ``("", label)`` on failure."""
    cmd = jj_diff_command(source.rev)
    label = " ".join(cmd)
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, check=True)
    except (FileNotFoundError, subprocess.CalledProcessError):
        return "", label
    return result.stdout, label


def build_watch_state(diff_text: str, output_path: str) -> ReviewState | None:
    """Build review state for *diff_text*, or None when it has no hunks."""
    if not diff_text.strip():
        return None
    hunks = parse_diff(diff_text)
    if not hunks:
        return None
    global_notes = load_or_resume_review(hunks, output_path, quiet=True)
    return ReviewState(
        hunks=hunks,
        global_notes=global_notes,
        current_index=ReviewState.initial_index(hunks),
    )


def watch_loop(
    term: Terminal,
    args: argparse.Namespace,
    source: JjSource,
) -> bool:
    """Drive watch-mode review; return whether a review file was written."""
    if args.clear:
        Path(args.output).unlink(missing_ok=True)
    watcher = restart_watcher(None)
    diff_text, diff_source = fetch_watch_diff(source)
    state = build_watch_state(diff_text, args.output)
    review_written = False
    try:
        while True:
            if state is None:
                result = term.run_wait_screen(watcher.read_fd)
            else:
                delta_cache: dict[int, DeltaStream] = {}
                result = term.run_review_loop(state, delta_cache, watcher.read_fd)
                if review_has_content(state.hunks, state.global_notes):
                    write_review_output(
                        args.output,
                        state.hunks,
                        state.global_notes,
                        diff_source,
                        quiet=True,
                    )
                    review_written = True
            if result is LoopResult.QUIT:
                return review_written
            new_diff, diff_source = fetch_watch_diff(source)
            if new_diff == diff_text and state is not None:
                continue
            diff_text = new_diff
            watcher = restart_watcher(watcher)
            state = build_watch_state(diff_text, args.output)
    finally:
        watcher.close()


def run_watch_session(args: argparse.Namespace, source: JjSource) -> None:
    """Run watch mode inside the alt screen, handling exit side effects."""
    with Terminal() as term:
        term.write(f"{term.ALT_SCREEN_ON}{term.CURSOR_HIDE}")
        try:
            review_written = watch_loop(term, args, source)
        finally:
            term.write(f"{term.CURSOR_SHOW}{term.ALT_SCREEN_OFF}")
    if review_written:
        sys.stderr.write(f"Review written to {compact_path(args.output)}\n")
        if args.clip:
            copy_output_reference_to_clipboard(args.output)


def run_single_session(
    args: argparse.Namespace,
    diff_text: str,
    diff_source: str | None,
) -> None:
    """Run a one-shot review session and write its output on exit."""
    hunks = parse_diff_or_exit(diff_text)

    if args.clear:
        Path(args.output).unlink(missing_ok=True)

    global_notes = load_or_resume_review(hunks, args.output)

    delta_cache: dict[int, DeltaStream] = {}
    state = ReviewState(
        hunks=hunks,
        global_notes=global_notes,
        current_index=ReviewState.initial_index(hunks),
    )

    with Terminal() as term:
        term.write(f"{term.ALT_SCREEN_ON}{term.CURSOR_HIDE}")
        try:
            term.run_review_loop(state, delta_cache)
        finally:
            term.write(f"{term.CURSOR_SHOW}{term.ALT_SCREEN_OFF}")

    if not review_has_content(hunks, global_notes):
        return
    if review_is_all_clear(hunks, global_notes):
        sys.stderr.write(ALL_CLEAR_MESSAGE)
    else:
        write_review_output(args.output, hunks, global_notes, diff_source)
        if args.clip:
            copy_output_reference_to_clipboard(args.output)


def resolve_diff_origin(
    args: argparse.Namespace,
    parser: argparse.ArgumentParser,
) -> JjSource | str:
    """
    Resolve where the diff comes from, from the -j flag or stdin.

    Returns a re-runnable jj source, or the piped stdin diff text.
    """
    source: JjSource | None = args.source
    if source is not None:
        return source
    try:
        return read_diff_from_stdin()
    except NoDiffOnStdinError:
        ensure_jj_or_exit(parser)
        return JjSource(None)


def main() -> None:
    """Run the neorev command-line entry point."""
    parser = build_arg_parser()
    args = parser.parse_args()
    resolve_args(args)

    if args.watch and shutil.which("inotifywait") is None:
        sys.stderr.write("Error: 'inotifywait' not found — required for --watch.\n")
        exit(os.EX_UNAVAILABLE)

    origin = resolve_diff_origin(args, parser)

    if args.watch:
        if isinstance(origin, str):
            parser.print_usage(sys.stderr)
            sys.stderr.write(
                "\nError: --watch needs a re-runnable jj source (-j or "
                "auto-detected); it cannot watch a piped diff.\n"
            )
            exit(os.EX_USAGE)
        run_watch_session(args, origin)
        return

    if isinstance(origin, str):
        diff_text, diff_source = origin, None
    else:
        diff_text, diff_source = run_jj_diff(origin)
    run_single_session(args, diff_text, diff_source)


if __name__ == "__main__":
    main()
