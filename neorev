class ReviewFooter(Footer):
    """Footer naming every key an action answers to, plus an optional row count."""

    def __init__(self, scroller: ScrollView | None = None) -> None:
        """Count what *scroller* keeps below its viewport, if given."""
        super().__init__()
        self.scroller = scroller

    def compose(self) -> ComposeResult:
        """Lay out the hints, each spelling out all its action keys, then the count."""
        for widget in super().compose():
            if isinstance(widget, FooterKey):
                widget.key_display = self.keys_of_action(widget.action)
            yield widget
        if self.scroller is not None:
            yield HiddenRows(self.scroller, ScrollEdge.BELOW)

    def keys_of_action(self, action: str) -> str:
        """Join the display of every shown key bound to *action*."""
        return KEY_SEPARATOR.join(
            self.app.get_key_display(active.binding)
            for active in self.screen.active_bindings.values()
            if active.binding.show and active.binding.action == action
        )


