class LinePicker(Screen[NoteTarget | None], inherit_bindings=False):
    """Full-screen picker choosing which line of a hunk a note targets."""

    BINDINGS: ClassVar[list[BindingType]] = [
        Binding("h", "whole_hunk", "whole hunk"),
        Binding("escape,q", "cancel", "cancel"),
    ]

    def __init__(
        self,
        state: ReviewState,
        kind: NoteKind,
        start_line: int,
        line_texts: list[Text],
    ) -> None:
        """Pick among *line_texts* of the current hunk, in the pick style of *kind*."""
        super().__init__()
        self.state = state
        self.start_line = start_line
        self.pick_style = (
            STYLE_PICK_FLAG if kind is NoteKind.FLAG else STYLE_PICK_QUESTION
        )
        self.line_texts = line_texts
        self.prompts: list[Text] = []
        self.painted: int | None = None

    def compose(self) -> ComposeResult:
        """Lay out the chrome, the line list and the key hints."""
        options = PickerList(self.rebuild)
        yield TopBar(self.state)
        yield MarkerRow(self.state, options)
        yield options
        yield ReviewFooter(options)

    def rebuild(self, width: int) -> None:
        """Build one option per diff line, each padded to *width*."""
        hunk = self.state.current_hunk
        self.prompts = [pad_to_width(text.copy(), width) for text in self.line_texts]
        options = self.query_one(PickerList)
        cursor = options.highlighted
        self.painted = None
        options.set_options(
            Option(prompt, disabled=self.line_target(index) is None)
            for index, prompt in enumerate(self.prompts)
        )
        if cursor is None:
            options.highlighted = initial_picker_line(hunk, self.start_line)
            options.scroll_to_highlight(top=True)
        else:
            options.highlighted = cursor
        if options.highlighted is not None:
            self.paint_cursor(options, options.highlighted)
        options.focus()

    def line_target(self, index: int) -> LineTarget | None:
        """Return the note target of the line at display *index*, if it has one."""
        lines = self.state.current_hunk.display_lines
        return lines[index].target if index < len(lines) else None

    def action_whole_hunk(self) -> None:
        """Choose the whole hunk as the note target."""
        self.dismiss(HunkTarget())

    def action_cancel(self) -> None:
        """Leave the picker without choosing a target."""
        self.dismiss(None)

    def paint_cursor(self, options: OptionList, index: int) -> None:
        """Draw the line at *index* in the pick style, restoring the one it left."""
        if index == self.painted:
            return
        if self.painted is not None:
            options.replace_option_prompt_at_index(
                self.painted, self.prompts[self.painted]
            )
        plain = Text(self.prompts[index].plain, justify="left")
        plain.stylize(self.pick_style)
        options.replace_option_prompt_at_index(index, plain)
        self.painted = index

    def on_option_list_option_highlighted(
        self,
        event: OptionList.OptionHighlighted,
    ) -> None:
        """Paint the line under the cursor, and repaint the one it left."""
        self.paint_cursor(event.option_list, event.option_index)

    def on_option_list_option_selected(
        self,
        event: OptionList.OptionSelected,
    ) -> None:
        """Choose the selected line as the note target."""
        self.dismiss(self.line_target(event.option_index))


class NotesScreen(ModalScreen[None], inherit_bindings=False):
    """Modal listing every note of the review for editing or deletion."""

    BINDINGS: ClassVar[list[BindingType]] = [
        Binding("e,enter", "edit", "edit"),
        Binding("d", "delete", "delete"),
        Binding("escape,q", "close", "close"),
    ]

    def __init__(
        self,
        state: ReviewState,
        edit: Callable[[str, str, list[str] | None], str],
        redraw_review: Callable[[], None],
    ) -> None:
        """Store the review *state*, the *edit* callback and *redraw_review*."""
        super().__init__()
        self.state = state
        self.edit = edit
        self.redraw_review = redraw_review
        self.notes: list[tuple[Hunk, HunkNote] | GlobalNote] = []

    def compose(self) -> ComposeResult:
        """Lay out the note list and the key hints."""
        yield ReviewOptionList(compact=True)
        yield ReviewFooter()

    def on_mount(self) -> None:
        """Fill the note list and give it the keyboard."""
        self.fill()
        self.query_one(OptionList).focus()

    def fill(self) -> None:
        """Rebuild the note list from the review state."""
        self.notes = self.state.all_notes()
        options = self.query_one(OptionList)
        cursor = options.highlighted or 0
        options.set_options(note_option_text(entry) for entry in self.notes)
        options.border_title = f"Notes ({len(self.notes)})"
        if self.notes:
            options.highlighted = min(cursor, len(self.notes) - 1)

    def highlighted_note(self) -> tuple[Hunk, HunkNote] | GlobalNote | None:
        """Return the note under the cursor, or None when the list is empty."""
        index = self.query_one(OptionList).highlighted
        return None if index is None else self.notes[index]

    def action_edit(self) -> None:
        """Rewrite the note under the cursor, dropping it when left empty."""
        entry = self.highlighted_note()
        if entry is None:
            return
        if isinstance(entry, GlobalNote):
            text = self.edit(entry.text, entry.kind.global_editor_label, None)
            if text:
                entry.text = text
            else:
                self.state.global_notes.remove(entry)
        else:
            hunk, note = entry
            context = hunk.build_editor_context(note.target, 0)
            text = self.edit(note.text, note.kind.editor_label, context)
            if text:
                note.text = text
            else:
                hunk.notes.remove(note)
        self.fill()

    def action_delete(self) -> None:
        """Drop the note under the cursor."""
        entry = self.highlighted_note()
        if entry is None:
            return
        if isinstance(entry, GlobalNote):
            self.state.global_notes.remove(entry)
        else:
            hunk, note = entry
            hunk.notes.remove(note)
        self.fill()

    def action_close(self) -> None:
        """Leave the note list."""
        self.redraw_review()
        self.dismiss()


